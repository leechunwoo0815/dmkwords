<!-- 头像 + 等级头像框（框比头像大 FRAME_SCALE，居中偏移由 js 算好） -->
<view class="ring" style="width:{{size}}rpx;height:{{size}}rpx;">
  <image class="ring-avatar" src="{{src}}" style="width:{{size}}rpx;height:{{size}}rpx;" mode="aspectFill" />
  <image
    wx:if="{{frameUrl}}"
    class="ring-frame"
    src="{{frameUrl}}"
    style="width:{{frameSize}}rpx;height:{{frameSize}}rpx;left:{{offset}}rpx;top:{{offset}}rpx;"
    mode="aspectFit"
  />
</view>
