.skeleton {
  padding: 24rpx;
}
.skeleton-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, var(--bg) 25%, #f4efe2 50%, var(--bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.skeleton-lines {
  flex: 1;
}
.skeleton-line {
  height: 24rpx;
  background: linear-gradient(90deg, var(--bg) 25%, #f4efe2 50%, var(--bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */
/* 列表项：卡片化 */
.list-item, .item, .row, .cell, .info-row {
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}

/* 网格变体（2026-09-13 新增）：书目类 2 列卡片页的加载骨架 */
.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.skeleton-card {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  overflow: hidden;
  padding-bottom: 16rpx;
}
.skeleton-card-cover {
  height: 340rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(90deg, var(--bg) 25%, #f4efe2 50%, var(--bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
.skeleton-card .skeleton-line {
  margin: 0 20rpx 12rpx;
}
