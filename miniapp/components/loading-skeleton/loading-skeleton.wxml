<view wx:if="{{loading}}" class="skeleton">
  <block wx:if="{{type === 'grid'}}">
    <view class="skeleton-grid">
      <view wx:for="{{rows}}" wx:key="index" class="skeleton-card">
        <view class="skeleton-card-cover"></view>
        <view class="skeleton-line" style="width: 80%;"></view>
        <view class="skeleton-line" style="width: 50%;"></view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view wx:for="{{rows}}" wx:key="index" class="skeleton-row">
      <view class="skeleton-avatar" wx:if="{{index === 0}}"></view>
      <view class="skeleton-lines">
        <view class="skeleton-line" style="width: {{index === rows - 1 ? '60%' : '100%'}};"></view>
      </view>
    </view>
  </block>
</view>
<slot wx:else></slot>
