/* frontend/components/error-view/error-view.wxss */
.error-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  min-height: 400rpx;
}
.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg);
  margin-bottom: 12rpx;
  text-align: center;
}
.error-desc {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.5;
}
.error-btn {
  background: var(--accent);
  color: var(--surface);
  border: none;
  border-radius: var(--radius);
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.error-btn-outline {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: var(--radius);
  padding: 20rpx 48rpx;
  font-size: 28rpx;
}
.error-contact {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
}

/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */
/* 按钮：胶囊贴纸 */
.btn, button, .primary-btn, .secondary-btn, .submit-btn, .action-btn {
  border: 3rpx solid var(--fg) !important;
  border-radius: 999rpx !important;
  box-shadow: var(--shadow-hard-sm) !important;
  font-weight: 700;
}
.btn-primary, .primary, button[type="primary"], .primary-btn {
  background: var(--accent) !important;
  color: #FFFDF7 !important;
}
.btn-secondary, .secondary, .secondary-btn {
  background: var(--surface) !important;
  color: var(--fg) !important;
}
.btn:active, button:active, .primary-btn:active, .secondary-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: none !important;
}

/* 标题圆体 */
.page-title, .section-title, .card-title, .header-title, .title, .name {
  font-family: var(--font-display);
  font-weight: 700;
}
