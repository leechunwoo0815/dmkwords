/* frontend/pages/checkin/checkin.wxss */

/* Nav Bar */
.nav-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

/* Streak Banner */
.streak-banner {
  margin: 32rpx;
  padding: 40rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: var(--surface);
  text-align: center;
}

.streak-banner .streak-num {
  font-family: var(--font-display);
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  display: block;
}

.streak-banner .streak-label {
  font-size: 28rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}

.streak-banner .streak-sub {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 8rpx;
  display: block;
}

.streak-stats {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-top: 24rpx;
}

.streak-stats .ss-item {
  text-align: center;
}

.streak-stats .ss-num {
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 700;
  display: block;
}

.streak-stats .ss-label {
  font-size: 22rpx;
  opacity: 0.8;
  display: block;
}

.today-card.checked {
  border-color: var(--success-soft);
  background: var(--success-soft);
}

.today-card.checked .tc-icon {
  background: var(--success-soft);
}

/* Calendar Card */
.calendar-card {
  margin: 0 32rpx 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cal-header .month {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
}

.cal-header .nav-btns {
  display: flex;
  gap: 8rpx;
}

.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.cal-weekdays {
  display: flex;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.cal-weekday {
  flex: 1;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cal-day {
  width: calc((100% - 48rpx) / 7);
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-variant-numeric: tabular-nums;
}

.cal-day .cal-day-text {
  font-size: 26rpx;
  font-weight: 500;
}

.cal-day.checked {
  background: var(--accent);
}

.cal-day.checked .cal-day-text {
  color: var(--surface);
}

.cal-day.today {
  border: 4rpx solid var(--fg);
}

.cal-day.today .cal-day-text {
  color: var(--accent);
}

/* 同天既 checked 又 today（今天打完卡）：橙底必须白字，优先级压过 .today 橙字 */
.cal-day.today.checked,
.cal-day.checked.today {
  border: 4rpx solid var(--fg);
}

.cal-day.today.checked .cal-day-text,
.cal-day.checked.today .cal-day-text {
  color: var(--surface);
  font-weight: 700;
}

.cal-day.empty {
  visibility: hidden;
}

/* 日历-今天边框 */
.cal-day.today {
  border: 4rpx solid var(--accent);
}

/* 日历-今天边框 */
.cal-day.today {
  border: 4rpx solid var(--accent);
}


/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */

/* 打卡横幅：活力橙渐变 + 粗黑边贴纸 */
.streak-banner {
  border: 3rpx solid var(--fg);
  border-radius: 32rpx 36rpx 28rpx 40rpx;
  box-shadow: var(--shadow-hard);
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  position: relative;
  overflow: hidden;
}
.streak-banner .streak-num {
  font-family: var(--font-display);
  font-weight: 800;
  color: var(--surface);
  text-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.45);
}

/* 日历卡：粗黑边 + 手绘圆角 */
.calendar-card {
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 32rpx 36rpx 28rpx 40rpx;
  box-shadow: var(--shadow-hard-sm);
}

/* 统计小卡贴纸 */
.streak-stats .ss-item {
  border: 2rpx solid rgba(var(--fg-rgb), 0.6);
  border-radius: 20rpx 24rpx 18rpx 26rpx;
  background: var(--surface);
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.35);
}

/* ============================================
   打卡页 v4 改造（2026-08-30）：数字与文案更清晰
   ============================================ */

.streak-banner .streak-num {
  font-size: 120rpx;
  line-height: 1;
  color: var(--surface);
  text-shadow: 4rpx 4rpx 0 rgba(var(--fg-rgb), 0.45);
}

.streak-banner .streak-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--surface);
  opacity: 1;
  margin-top: 12rpx;
}

.streak-banner .streak-sub {
  font-size: 28rpx;
  color: var(--surface);
  opacity: 0.95;
  margin-top: 12rpx;
  font-weight: 600;
}

.streak-stats .ss-num {
  color: var(--accent);
}

.streak-stats .ss-label {
  color: var(--fg);
  opacity: 1;
  font-weight: 600;
}


/* ===== 2026-09-13 内联样式迁移（机械生成，勿手改） ===== */
.x-cb307e { min-height: 100vh; padding: 24rpx; }
.x-f0c0b3 { font-size: 32rpx; font-weight: 600; color: var(--fg); }
.x-9a915c { font-weight: 800; color: var(--surface); font-size: 40rpx; }
.x-43089c { margin-top: 24rpx; color: var(--muted); font-size: 24rpx; text-align: center; }

.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  /* 底部留白 ≥ 固定 .bottom-nav（约 170rpx）+ 安全区：末行不被底栏压住 */
  padding: 20rpx 24rpx calc(200rpx + env(safe-area-inset-bottom));
}
