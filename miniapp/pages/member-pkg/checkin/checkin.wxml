<view class="page-bg x-cb307e">
  <view class="streak-banner">
    <view class="cal-header">
      <text class="cal-nav-btn" bindtap="onPrevMonth">‹</text>
      <text class="x-f0c0b3">{{monthText}}</text>
      <text class="cal-nav-btn" bindtap="onNextMonth">›</text>
    </view>
    <view class="streak-stats">
      <view>连续打卡 <text class="x-9a915c">{{currentStreak}}</text> 天</view>
      <view>今日：{{todayChecked ? '已打卡 ✓' : '听完一本书即可打卡'}}</view>
    </view>
  </view>

  <view class="calendar-card">
    <view class="cal-weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="cal-weekday">{{item}}</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{days}}" wx:key="index"
        class="cal-day {{item.blank ? 'empty' : ''}} {{item.checked ? 'checked' : ''}} {{item.isToday ? 'today' : ''}}">
        <text class="cal-day-text">{{item.blank ? '' : item.day}}</text>
      </view>
    </view>
  </view>

  <view class="x-43089c">
    {{childName}} · 当天首次完播自动打卡，重复听书不重复计
  </view>
</view>
