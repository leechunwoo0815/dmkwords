<view class="page-bg x-cb307e">
  <view class="report-header">
    <image class="rh-icon" src="/icons/ui/clipboard.png" mode="aspectFit" />
    <view>
      <view class="rh-title">{{childName}} 的观察期评估</view>
      <view class="rh-period">由馆内老师评估上传 · 每一阶段的成长记录</view>
    </view>
  </view>

  <view class="x-36e383" wx:if="{{loading}}">加载中…</view>

  <empty-state wx:if="{{!loading && !reports.length}}"
    icon-name="clipboard" title="还没有评估报告" desc="老师上传后这里会展示" />

  <view wx:for="{{reports}}" wx:key="id" class="stat-card x-560223">
    <view class="x-545127">
      <text class="x-b9cc9c">{{item.created_at}}</text>
    </view>
    <view class="x-f09e24" wx:if="{{item.remark}}">
      {{item.remark}}
    </view>
    <view class="x-12d486">
      <image class="x-6e6b5a" wx:for="{{item.imageUrls}}" wx:for-item="img" wx:key="*this"
        src="{{img}}" mode="aspectFill"
        data-src="{{img}}" bindtap="onPreview" />
    </view>
  </view>

  <view class="x-87d128" wx:if="{{preview}}"
    bindtap="onClosePreview">
    <image class="x-9dfda0" src="{{preview}}" mode="aspectFit" />
  </view>
</view>
