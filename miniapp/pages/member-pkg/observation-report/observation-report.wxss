/* pages/member-pkg/observation-report/observation-report.wxss — 评估报告（2026-09-21 重排）
   用户报障「看不清、太简陋」→ 展示口径见 docs/15 §十九：竖版整页展示 + 原生缩放预览 +
   「老师评语」前置 + 最新一期展开 / 往期折叠。 */

.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部：孩子 + 期数 ---------- */
.obs-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
  color: var(--surface);
}
.obs-hero-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.obs-hero-main {
  flex: 1;
  min-width: 0;
}
.obs-hero-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 700;
}
.obs-hero-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.92;
}
.obs-hero-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
  flex-shrink: 0;
}
.obs-hero-count-num {
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--accent);
}
.obs-hero-count-unit {
  font-size: 18rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* ---------- 状态 ---------- */
.obs-loading {
  text-align: center;
  color: var(--muted);
  padding: 60rpx;
}

/* ---------- 报告纸卡（最新一期） ---------- */
.obs-paper {
  margin-top: 24rpx;
  padding-bottom: 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
  overflow: hidden;
}
.obs-paper-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx 16rpx;
}
.obs-issue {
  font-family: var(--font-display);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-darker);
  background: var(--warning-soft);
  border: 2rpx solid var(--fg);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.obs-date {
  flex: 1;
  font-size: 24rpx;
  color: var(--muted);
}
.obs-pages {
  font-size: 22rpx;
  color: var(--muted);
}

/* ---------- 老师评语（图之前：能直接读的先给家长） ---------- */
.obs-comment {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: var(--warning-soft);
  border: 2rpx dashed var(--warning);
  border-radius: 24rpx;
}
.obs-comment-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.obs-comment-body {
  flex: 1;
  min-width: 0;
}
.obs-comment-label {
  font-family: var(--font-display);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--warning-dark);
}
.obs-comment-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--fg);
  text-indent: 60rpx;
}

/* ---------- 整页报告图（满卡宽：给足像素才看得清） ---------- */
.obs-pages-wrap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.obs-page {
  position: relative;
  background: var(--bg);
}
.obs-page-img {
  width: 100%;
  display: block;
}
.obs-page-no {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sun);
  border: 2rpx solid var(--fg);
  color: var(--fg);
  font-size: 22rpx;
  font-weight: 700;
}
.obs-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 20rpx 24rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}
.obs-hint-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.75;
}

/* ---------- 往期（默认收起） ---------- */
.obs-hist {
  margin-top: 28rpx;
}
.obs-hist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-hard-sm);
}
.obs-hist-title {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 700;
}
.obs-hist-arrow {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.2s;
}
.obs-hist-arrow.is-open {
  transform: rotate(180deg);
}
.obs-hist-card {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}
/* 缩略图比例必须竖版（≥3:4）——方形裁切会把报告首尾砍掉（docs/15 §十九） */
.obs-hist-thumb {
  position: relative;
  width: 240rpx;
  height: 320rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  overflow: hidden;
  background: var(--bg);
}
.obs-hist-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}
.obs-hist-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.obs-hist-line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.obs-hist-issue {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 700;
}
.obs-hist-date {
  font-size: 22rpx;
  color: var(--muted);
}
.obs-thumb-no {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--fg);
  color: var(--surface);
  font-size: 20rpx;
}
.obs-hist-remark {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--muted);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.obs-hist-more {
  margin-top: auto;
  padding-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent-darker);
}
