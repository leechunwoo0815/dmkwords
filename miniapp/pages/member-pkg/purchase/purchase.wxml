<view class="page-bg">
  <!-- P2-15（第九轮审查）：失败态显式呈现——原先失败时这行会留首屏默认文案
       （"iOS 端不提供在线开通"），把网络故障讲成平台政策 -->
  <error-view wx:if="{{loadError}}" type="network" title="会员方案加载失败"
    desc="{{loadError}}（方案未加载，请重试或到店咨询）" bind:onRetry="onRetryLoad" />
  <view class="head-hint" wx:else>{{headHint}}</view>

  <view class="plan-card" wx:for="{{plans}}" wx:key="order_type">
    <view class="plan-badge {{item.badgeCls}}">{{item.label}}</view>
    <view class="plan-price">{{item.priceText}}</view>
    <view>
      <view class="plan-feat" wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this">{{feat}}</view>
    </view>
    <view wx:if="{{!item.available}}" class="plan-reason">{{item.reason}}</view>
  </view>

  <view class="store-card">
    <view class="store-title">到店办理会员服务</view>
    <view class="store-line">① 携孩子到店，由馆员核定方案与服务费</view>
    <view class="store-line">② 到店缴纳会员服务费（微信/现金等门店方式）</view>
    <view class="store-line">③ 馆员确认收款后，会员服务在小程序内生效</view>
    <view class="store-line store-soft">会员服务以到店核验为准；小程序仅展示服务方案，不提供线上支付。</view>
  </view>

  <view class="orders-entry" bindtap="goOrders">查看我的订单 ›</view>

  <view class="pay-wrap">
    <pay-button amount="{{0}}" buttonText="到店办理会员服务" bind:pay="onStoreGuide" />
  </view>
</view>
