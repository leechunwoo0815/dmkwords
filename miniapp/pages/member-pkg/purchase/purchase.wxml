<view class="page-bg">
  <view class="head-hint">{{headHint}}</view>

  <view class="plan-card" wx:for="{{plans}}" wx:key="order_type">
    <view class="plan-badge {{item.badgeCls}}">{{item.label}}</view>
    <view class="plan-price">{{item.priceText}}</view>
    <view>
      <view class="plan-feat" wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this">{{feat}}</view>
    </view>
    <view wx:if="{{!item.available}}" class="plan-reason">{{item.reason}}</view>
    <view wx:if="{{showPay}}"
      class="plan-cta {{item.available ? '' : 'plan-cta-off'}} {{paying ? 'plan-cta-busy' : ''}}"
      data-type="{{item.order_type}}"
      bindtap="onBuy">{{item.available ? '立即开通' : '不可购买'}}</view>
  </view>

  <view class="store-card">
    <view class="store-title">到店 / 联系馆员办理</view>
    <view class="store-line">① 携孩子到店，由馆员核定方案与价格</view>
    <view class="store-line">② 到店支付或按馆方指引完成缴费</view>
    <view class="store-line">③ 馆员确认收款后，会员状态在小程序内生效</view>
    <view class="store-line store-soft">会员资格以到店核验为准；线上开通以支付结果为准。</view>
  </view>

  <view class="orders-entry" bindtap="goOrders">查看我的订单 ›</view>

  <view class="pay-wrap" wx:if="{{!showPay}}">
    <view wx:if="{{payBlocked === 'login'}}" class="login-hint">线上开通需微信一键登录：请退出后在登录页选择「微信一键登录」；也可到店办理。</view>
    <pay-button wx:else amount="{{0}}" buttonText="到店办理会员" bind:pay="onStoreGuide" />
  </view>
</view>
