/* frontend/pages/achievement/achievement.wxss */

/* 页面背景 */
.page-bg {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 级别卡片 */
.level-card {
  margin: 32rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  color: var(--surface);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.level-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(var(--surface-rgb), 0.1);
}
/* 等级盾牌：level_template.png 资产 + 等级字母叠加（不再用 emoji 奖牌） */
.level-shield {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 16rpx;
}
.level-shield-img {
  width: 150rpx;
  height: 150rpx;
  display: block;
}
.level-shield-letter {
  position: absolute;
  left: 0;
  right: 0;
  top: 52rpx;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 52rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1;
}
.level-name {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
}
.level-desc {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.level-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 32rpx;
}
.level-stat {
  text-align: center;
}
.level-stat .num {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}
.level-stat .label {
  font-size: 22rpx;
  opacity: 0.8;
}
.level-progress {
  margin-top: 28rpx;
}
.level-progress-bar {
  height: 12rpx;
  background: var(--white-soft);
  border-radius: 6rpx;
  overflow: hidden;
}
.level-progress-fill {
  height: 100%;
  background: var(--surface);
  border-radius: 6rpx;
}
.level-progress-text {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  text-align: right;
}

/* 徽章网格 */
.badges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 80rpx 32rpx 32rpx;
}
/* 勋章卡两态（docs/15 §二十一）：**已达成要有正向待遇**——金纸痕底 + 墨线实边 + 全彩徽章 + 金色「已达成」；
   未达成才是淡的：白底 + 虚线边 + 徽章 40% 透明 + 「未达成」淡字。
   （此前两态只靠"少一行未达成字样"区分，用户口径是"没达到的就是没达到"，同样也要求"达到了要看得见"。） */
.badge-card {
  width: calc(33.333% - 16rpx);
  background: var(--surface);
  border: 2rpx dashed var(--border);
  border-radius: var(--radius);
  padding: 32rpx 16rpx;
  text-align: center;
  box-sizing: border-box;
}
.badge-card.is-unlocked {
  background: var(--warning-soft);
  border: 3rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
}
.badge-card.is-locked .badge-icon {
  opacity: 0.4;
}
.badge-card.is-locked .badge-name {
  color: var(--muted);
}
.badge-icon {
  width: 120rpx;
  height: 120rpx;
  display: block;
  margin: 0 auto 12rpx;
}
.badge-state {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.3;
}
.badge-state.on {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--sun);
  border: 2rpx solid var(--fg);
  color: var(--fg);
  font-weight: 700;
}
.badge-state.off {
  color: var(--muted);
}
.badge-date {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.badge-name {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.badge-date {
  font-size: 20rpx;
  color: var(--muted);
}
.badge-card.locked .badge-date {
  color: var(--border);
}

/* 时间线 */
.timeline {
  padding: 32rpx;
}
.tl-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  padding-bottom: 40rpx;
}
.tl-item:last-child {
  padding-bottom: 0;
}
.tl-item::before {
  content: '';
  position: absolute;
  left: 36rpx;
  top: 76rpx;
  bottom: 0;
  width: 4rpx;
  background: var(--border);
}
.tl-item:last-child::before {
  display: none;
}
.tl-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: var(--surface);
  border: 4rpx solid var(--accent);
}
.tl-content {
  flex: 1;
  padding-top: 8rpx;
}
.tl-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}
.tl-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
  display: block;
}
.tl-time {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  display: block;
}
.m-name {
  font-family: var(--font-mono);
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.m-label {
  color: var(--muted);
}
.badges-grid {
  display: flex;
}
.badges-grid.active {
  display: flex;
}.badge{
  border: 2rpx solid rgba(var(--fg-rgb), 0.6);
  border-radius: 999rpx;
  font-weight: 700;
}.name{
  font-family: var(--font-display);
  font-weight: 700;
}.row{
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}


