<view class="page-bg x-cb307e">
  <!-- W7-03（第十轮 P2，2026-10-24）：取数失败必须有可见态——原先两个接口都静默 catch →
       level 卡被 wx:if 藏掉、积分区落到「还没有积分记录」，看起来像等级/积分被清零 -->
  <error-view wx:if="{{loadError}}" type="network" title="成长数据加载失败"
    desc="{{loadError}}（不是「没有积分记录」，请重试）" bind:onRetry="onRetryLoad" />

  <block wx:else>
  <view class="level-card" wx:if="{{summary}}">
    <view class="level-shield">
      <image class="level-shield-img" src="/icons/badges/level_template.png" mode="aspectFit" />
      <text class="level-shield-letter">{{summary.level}}</text>
    </view>
    <view class="level-name">{{summary.level}} 级</view>
    <view class="level-desc">
      {{childName}} · 已有效阅读 {{summary.books_total}} 本书（每 {{summary.level_books_threshold}} 本升一级，只升不降）
    </view>
    <view class="level-progress">
      <view class="level-progress-bar">
        <view class="level-progress-fill" style="width: {{summary.level_books_threshold ? (summary.progress_in_level * 100 / summary.level_books_threshold) : 0}}%"></view>
      </view>
      <view class="level-progress-text">
        {{summary.is_z_capped ? '已达 Z 级封顶，继续累计' : '本级进度 ' + summary.progress_in_level + ' / ' + summary.level_books_threshold + ' 本'}}
      </view>
    </view>
    <view class="level-stats">
      <view class="level-stat">
        <view class="m-name">{{summary.words_total}}</view>
        <view class="m-label">有效词数</view>
      </view>
      <view class="level-stat">
        <view class="m-name">{{summary.points_total}}</view>
        <view class="m-label">积分</view>
      </view>
      <view class="level-stat">
        <view class="m-name">{{summary.words_remainder}}</view>
        <view class="m-label">零头池(词)</view>
      </view>
    </view>
  </view>

  <view class="section-label x-03f368">里程碑勋章</view>
  <view class="badges-grid">
    <view wx:for="{{badges}}" wx:key="node"
      class="badge-card {{item.unlocked ? 'is-unlocked' : 'is-locked'}}">
      <image class="badge-icon" src="{{item.iconUrl}}" mode="aspectFit" />
      <view class="badge-name">{{item.label}}</view>
      <view class="badge-state {{item.unlocked ? 'on' : 'off'}}">{{item.unlocked ? '已达成' : '未达成'}}</view>
      <text class="badge-date" wx:if="{{item.unlocked && item.dateText}}">{{item.dateText}} 达成</text>
    </view>
  </view>

  <view class="section-label x-03f368">最近积分明细</view>
  <view class="timeline">
    <view wx:for="{{points}}" wx:key="id" class="tl-item">
      <view class="tl-dot"></view>
      <view class="tl-content">
        <view class="tl-name">{{item.detail}}</view>
        <view class="tl-time">{{item.created_at}}</view>
      </view>
      <view class="tl-desc x-f31427">+{{item.points}}</view>
    </view>
    <!-- W7-03：空态只在「成功且确实为空」时出现（失败已由上方 error-view 表达） -->
    <view class="x-a0f80c" wx:if="{{!points.length && !loadError}}">还没有积分记录</view>
  </view>
  </block>
</view>
