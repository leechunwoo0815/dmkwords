<view class="page" wx:if="{{passport}}">
  <view class="profile-card">
    <view class="card-header">
      <avatar-ring size="{{84}}" src="{{avatarUrl}}" level="{{passport.level}}" />
      <view class="card-identity">
        <view class="card-en-name">{{passport.english_name || passport.child_name}}</view>
        <view class="card-cn-name">{{passport.child_name}} 的阅读护照</view>
        <view class="card-date">累计有效阅读 · 永不丢失</view>
      </view>
      <view class="level-badge-icon">
        <image class="level-badge-shield" src="/icons/badges/level_template.png" mode="aspectFit" />
        <text class="level-badge-letter">{{passport.level}}</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-val">{{passport.words_total}}</view>
        <view class="stat-label">有效词数</view>
      </view>
      <view class="stat-item">
        <view class="stat-val">{{passport.books_total}}</view>
        <view class="stat-label">读完本数</view>
      </view>
      <view class="stat-item">
        <view class="stat-val">{{passport.points_total}}</view>
        <view class="stat-label">积分</view>
      </view>
      <view class="stat-item">
        <view class="stat-val">{{passport.total_checkin_days}}</view>
        <view class="stat-label">打卡天数</view>
      </view>
    </view>

    <view class="card-divider"></view>

    <view class="level-section">
      <view class="level-title">成长等级 {{passport.level}} 级</view>
      <view class="level-subtitle">
        {{passport.is_z_capped ? '已达 Z 级封顶，继续累计' : '每 ' + passport.level_books_threshold + ' 本升一级，只升不降'}}
      </view>
    </view>

    <view class="milestone-head">
      <text class="milestone-title">里程碑 {{unlockedCount}} / {{milestones.length}} 枚已解锁</text>
      <text class="milestone-next" wx:if="{{nextHint}}">{{nextHint}}</text>
    </view>
    <view class="achievements">
      <view class="ach-item {{item.unlocked ? 'is-unlocked' : 'is-locked'}}"
        wx:for="{{milestones}}" wx:key="node">
        <image class="ach-icon" src="{{item.iconUrl}}" mode="aspectFit" />
        <text class="ach-name">{{item.label}}</text>
        <view class="ach-state {{item.unlocked ? 'on' : 'off'}}">{{item.unlocked ? '已达成' : '未达成'}}</view>
        <text class="ach-date" wx:if="{{item.unlocked && item.dateText}}">{{item.dateText}}</text>
      </view>
    </view>

    <view class="card-footer">
      <text>DmkWords · 分级阅读听见成长</text>
    </view>
  </view>

  <!-- WM14-A：我的成就入口（常驻晒卡入口——历史成就补晒，PRD §7.5） -->
  <view wx:if="{{!passport.read_only}}" class="my-achievements-entry" bindtap="goMyCards">
    <view class="ach-entry-left">
      <image class="ach-entry-icon" src="/icons/ui/trophy.png" mode="aspectFit" />
      <view>
        <view class="ach-entry-title">我的成就</view>
        <view class="ach-entry-sub">里程碑/满分/连击…晒到馆内阅读圈</view>
      </view>
    </view>
    <text class="ach-entry-arrow">›</text>
  </view>

  <view wx:if="{{passport.read_only}}" class="tip x-158c51">
    已退会：护照为只读历史（词数等级永不回收）
  </view>

  <view class="x-1595cd" wx:if="{{passport.recent_books.length}}">
    <view class="x-bc7dc8">最近读完</view>
    <view class="x-255591" wx:for="{{passport.recent_books}}" wx:key="id">
      <text>《{{item.title}}》</text>
      <text class="x-0c7277">+{{item.word_count}} 词</text>
    </view>
  </view>

  <button class="btn-primary x-1595cd" open-type="share" wx:if="{{!passport.read_only}}">分享这份成长</button>
</view>
