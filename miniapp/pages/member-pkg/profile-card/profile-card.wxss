/* frontend/pages/profile-card/profile-card.wxss */

.page {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.nav-bar .title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fg);
}

/* Profile Card */
.profile-card {
  background: linear-gradient(160deg, var(--accent) 0%, var(--accent-dark) 45%, var(--accent-darker) 100%);
  border-radius: 40rpx;
  padding: 56rpx 48rpx 48rpx;
  /* 2026-09-17：此前无外边距，护照卡左右顶到屏幕边（用户实测「两边没留白」）。
     24rpx 与本页其余区块（.x-1595cd/.my-achievements-entry）同档。
     同时把左右内边距 48→32rpx：卡片窄了 48rpx 后「演示孩 的阅读护照」被挤成两行，
     内边距让回同样的宽度，标题恢复单行（横向净占位与加边距前一致）。 */
  padding: 56rpx 32rpx 48rpx;
  margin: 24rpx;
  color: var(--surface);
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 64rpx var(--sky-soft);
}

/* Card Header */
.card-header {
  display: flex;
  align-items: center;
  /* 2026-09-17：32→24rpx，为加边距后变窄的卡片让宽度（防标题折行） */
  gap: 24rpx;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* 2026-09-17：头像改走共享件 avatar-ring（等级头像框资产 FRAME_SCALE=440/256 溢出
   在四周、**不参与布局**）。尺寸 84rpx 是按本卡的横向余量反推的：框溢出量
   = size×(FRAME_SCALE-1)/2 ≈ 30rpx，必须 ≤ 卡片左内边距 32rpx，否则框被卡片的
   overflow:hidden 切掉。改尺寸前先算这条。 */
.card-identity {
  flex: 1;
}

.card-cn-name {
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--surface);
  display: block;
}

.card-en-name {
  font-size: 28rpx;
  opacity: 0.8;
  margin-top: 4rpx;
  font-weight: 500;
  color: var(--surface);
  display: block;
}

/* Level Badge */
.level-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* 等级徽章 = 盾牌资产 + 字母叠加（与「等级与勋章」页同一套语言，不再用纯色方块） */
.level-badge-icon {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}
.level-badge-shield {
  width: 92rpx;
  height: 92rpx;
  display: block;
}
.level-badge-letter {
  position: absolute;
  left: 0;
  right: 0;
  top: 30rpx;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1;
}

.level-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--surface);
}

.level-subtitle {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 2rpx;
  color: var(--surface);
}

/* Stats Row */
.stats-row {
  display: flex;
  gap: 0;
  margin-bottom: 40rpx;
  background: rgba(var(--surface-rgb), 0.1);
  border-radius: 32rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
  border-right: 2rpx solid rgba(var(--surface-rgb), 0.1);
}

.stat-item:last-child {
  border-right: none;
}

/* 数字走等宽（docs/15 §17.1 字体分工）：手写体数字偏宽且不等宽，
   "102320" 这种六位数会把 4 等分格子撑到贴边（2026-09-21 目视发现） */
.stat-val {
  font-family: var(--font-mono);
  font-size: 34rpx; /* 手写体数字偏宽且不等宽，"102320" 在 4 等分格子里顶到边；换等宽并降到 34rpx（目视确认两侧留白恢复；miniapp 无文本测宽 API，故以截图为准） */
  font-weight: 700;
  color: var(--surface);
  display: block;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
  color: var(--surface);
  display: block;
}

/* Achievements */
.achievements {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* 里程碑两态（docs/15 §二十一）：已达成 = 亮白底 + 实线 + 全彩奖牌；未达成 = 淡底 + 虚线 + 40% 图标 */
.ach-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  background: rgba(var(--surface-rgb), 0.12);
  border: 2rpx dashed rgba(var(--surface-rgb), 0.4);
  border-radius: 20rpx;
}
.ach-item.is-unlocked {
  background: rgba(var(--surface-rgb), 0.96);
  border: 3rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
}
.ach-item.is-locked .ach-icon {
  opacity: 0.4;
}
.ach-item.is-locked .ach-name {
  color: var(--surface);
  opacity: 0.8;
}
/* 状态行：已达成=金色贴片（与勋章页同款），未达成=淡字 */
.ach-state {
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 1.25;
  white-space: nowrap; /* 格宽仅 52pt：「已达成」不许折成"已达/成"（2026-09-21 目视） */
}
.ach-state.on {
  display: inline-block;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: var(--sun);
  border: 2rpx solid var(--fg);
  color: var(--fg);
  font-weight: 700;
}
.ach-state.off {
  color: var(--surface);
  opacity: 0.7;
}
.ach-date {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--muted);
}
/* 里程碑标题行：解锁进度 + 下一枚目标 */
.milestone-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}
.milestone-title {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--surface);
}
.milestone-next {
  font-size: 22rpx;
  color: var(--surface);
  opacity: 0.9;
}

.ach-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
  display: block;
}

.ach-name {
  font-size: 22rpx;
  opacity: 0.85;
  color: var(--surface);
}
.ach-item.is-unlocked .ach-name {
  color: var(--fg);
  font-weight: 700;
  opacity: 1;
}

/* Divider */
.card-divider {
  height: 2rpx;
  background: rgba(var(--surface-rgb), 0.12);
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

/* Brand Footer */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}

.card-date {
  font-size: 22rpx;
  opacity: 0.5;
  color: var(--surface);
}

.btn-primary {
  background: var(--accent);
  color: var(--surface);
}

.btn-primary:active {
  background: var(--accent-hover);
}

/* Toast */
.toast {
  position: fixed;
    box-sizing: border-box;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(var(--fg-rgb), 0.8);
  padding: 28rpx 48rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--surface);
  box-sizing: border-box;
  z-index: 100;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
}

.toast.show {
  opacity: 1;
}

/* Tip */
.tip {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: var(--muted);
}/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */
/* 卡片：粗黑边 + 硬阴影 + 手绘圆角 */
.card{
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}button{
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  font-weight: 700;
}.btn-primary, button[type="primary"]{
  background: var(--accent);
  color: var(--surface);
}button:active{
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}.badge{
  border: 2rpx solid rgba(var(--fg-rgb), 0.6);
  border-radius: 999rpx;
  font-weight: 700;
}.title, .name{
  font-family: var(--font-display);
  font-weight: 700;
}.item{
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}

/* WM14-A：我的成就入口（晒成就常驻入口） */
.my-achievements-entry {
  margin: 24rpx;
  padding: 26rpx 30rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 22rpx;
  box-shadow: var(--shadow-hard-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ach-entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.ach-entry-icon {
  font-size: 52rpx;
}
.ach-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg);
}
.ach-entry-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.ach-entry-arrow {
  font-size: 40rpx;
  color: var(--muted);
}
.x-158c51 { margin: 24rpx; text-align: center; color: var(--muted); }
.x-1595cd { margin: 24rpx; }
.x-bc7dc8 { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: var(--fg); }
.x-255591 { background: var(--surface); border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between; }
.x-0c7277 { color: var(--accent); font-weight: 600; }

.ach-icon { width: 44rpx; height: 44rpx; }
.ach-entry-icon { width: 44rpx; height: 44rpx; }

/* 2026-09-17：最近读完——书名字长时右侧「+N 词」被挤折行（"词"独占第二行）
   且与书名零间距。覆盖机械生成的 .x-255591/.x-0c7277：徽章不收缩不折行，
   与书名留固定间距（gap 不参与收缩，书名自己折行）。 */
.x-255591 { gap: 16rpx; }
.x-0c7277 { flex: 0 0 auto; white-space: nowrap; }
