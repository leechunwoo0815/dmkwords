/* frontend/pages/leaderboard/leaderboard.wxss */

/* 页面背景 */
.page-bg {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 周期标签 */
.period-tabs {
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
}
.period-tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  background: var(--bg);
  border: 2rpx solid var(--border);
  margin-right: 12rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
}
.period-tab.active {
  background: var(--accent);
  color: var(--surface);
  border-color: var(--accent);
}

/* 排行列表 */
.rank-list {
  padding: 8rpx 32rpx;
}
.rank-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
}
.rank-item-me {
  border-color: var(--accent);
  background: var(--accent-soft);
}
.rank-num {
  width: 56rpx;
  text-align: center;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--muted);
  flex-shrink: 0;
}
.rank-info {
  flex: 1;
  min-width: 0;
}
.rank-name {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-words {
  font-size: 24rpx;
  color: var(--muted);
  display: block;
}

/* 规则卡片 */
.rules-card {
  margin: 16rpx 32rpx 32rpx;
  padding: 28rpx 32rpx;
  background: var(--sky-soft);
  border-radius: var(--radius);
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}
.rules-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.rules-text {
  display: block;
}

/* 排行项目 - 我的排名高亮 */
.rank-item-me {
  border-color: var(--accent);
  background: var(--sky-soft);
}

/* 排行项目 - 我的排名高亮 */
.rank-item-me {
  border-color: var(--accent);
  background: var(--sky-soft);
}.name{
  font-family: var(--font-display);
  font-weight: 700;
}

/* WM15-A2：榜单头像改用系统内置头像图（此前硬编码 🧒/👤，Child.avatar 字段形同虚设） */
.rank-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid rgba(var(--fg-rgb), 0.18);
}


