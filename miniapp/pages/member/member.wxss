/* frontend/pages/member/member.wxss */
/* Design translation from design/user-end/member.html */

/* Page bg (tabBar 页预留底部空间) */
.page-bg {
  padding-bottom: 160rpx;
}

/* ================================================================
   Profile Header
   ================================================================ */
.profile-header {
  background: var(--surface);
  padding: 48rpx 32rpx 40rpx;
  border-bottom: 2rpx solid var(--border);
}
.profile-top {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 24rpx;
}
.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-soft), rgba(44, 74, 110, 0.2));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid rgba(44, 74, 110, 0.15);
}
.profile-info {
  flex: 1;
}
.profile-name {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
}
.profile-level {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-top: 8rpx;
  background: rgba(53, 112, 60, 0.1);
  color: var(--success);
  font-size: 24rpx;
  font-weight: 600;
}
.profile-settings {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* ================================================================
   Member Status Card
   ================================================================ */
.member-card {
  margin: 32rpx;
  border-radius: var(--radius-lg);
  padding: 40rpx;
  position: relative;
  overflow: hidden;
  color: var(--surface);
  background: linear-gradient(135deg, var(--muted) 0%, #78716c 100%);
}
.member-card.official {
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
}
.member-card.observation {
  background: linear-gradient(135deg, var(--success), #2da83e);
}
.mc-deco {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.mc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.mc-status {
  font-size: 28rpx;
  font-weight: 600;
}
.mc-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  font-weight: 600;
}
.mc-countdown {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}
.mc-countdown-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.mc-expires {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 16rpx;
}

/* ================================================================
   Quick Stats (4-column grid)
   ================================================================ */
/* ================================================================
   Child Switcher
   ================================================================ */
.child-switcher {
  margin: 0 32rpx 24rpx;
}
.child-switcher-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}
.child-switcher-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  overflow-x: auto;
}
.child-switcher-chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  font-size: 26rpx;
  font-weight: 500;
}
.child-switcher-chip.active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* ================================================================
   Tier List
   ================================================================ */
.tier-list {
  margin: 0 32rpx 32rpx;
}
.tier-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tier-card {
  width: calc(50% - 8rpx);
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx 20rpx;
  position: relative;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.tier-tag {
  position: absolute;
  top: -8rpx;
  right: 16rpx;
  background: var(--accent);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.tier-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}
.tier-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
}
.tier-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}
.tier-ios-note {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}
.tier-features {
  margin: 16rpx 0;
}
.tier-feature {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
.tier-cta {
  margin-top: 12rpx;
  width: 100%;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
  line-height: 1.4;
  text-align: center;
}
.tier-cta:active {
  opacity: 0.85;
}

.quick-stats {
  margin: 0 32rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.qs-item {
  width: calc(25% - 12rpx);
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(38, 36, 25, 0.03);
  box-sizing: border-box;
}
.qs-val {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}
.qs-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.qs-item:nth-child(1) .qs-val { color: var(--accent); }
.qs-item:nth-child(2) .qs-val { color: var(--success); }
.qs-item:nth-child(3) .qs-val { color: var(--success); }
.qs-item:nth-child(4) .qs-val { color: var(--warning); }

/* ================================================================
   Section Title
   ================================================================ */
.section-title {
  margin: 32rpx 32rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* ================================================================
   Function Grid (5-column grid)
   ================================================================ */
.func-grid {
  margin: 0 32rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.func-item {
  width: calc(20% - 13rpx);
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx 4rpx 20rpx;
  box-sizing: border-box;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.func-item:active {
  transform: scale(0.95);
}
.fi-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.fi-label {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--fg);
  line-height: 1.3;
}
/* Icon background colors — order matches prototype */
.func-item:nth-child(1) .fi-icon { background: var(--accent-soft); }
.func-item:nth-child(2) .fi-icon { background: rgba(53, 112, 60, 0.1); }
.func-item:nth-child(3) .fi-icon { background: rgba(53, 112, 60, 0.1); }
.func-item:nth-child(4) .fi-icon { background: rgba(141, 102, 16, 0.12); }
.func-item:nth-child(5) .fi-icon { background: rgba(181, 64, 40, 0.08); }
.func-item:nth-child(6) .fi-icon { background: rgba(111, 104, 90, 0.1); }
.func-item:nth-child(7) .fi-icon { background: rgba(53, 112, 60, 0.12); }
.func-item:nth-child(8) .fi-icon { background: rgba(141, 102, 16, 0.1); }
.func-item:nth-child(9) .fi-icon { background: rgba(44, 74, 110, 0.08); }
.func-item:nth-child(10) .fi-icon { background: rgba(53, 112, 60, 0.12); }

/* ================================================================
   Bottom Links
   ================================================================ */
.bottom-links {
  margin: 0 32rpx 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--border);
}
.link-item:last-child {
  border-bottom: none;
}
.lk-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.lk-icon {
  font-size: 36rpx;
}
.lk-text {
  font-size: 28rpx;
}
.lk-arrow {
  font-size: 28rpx;
  color: var(--muted);
}

/* C22 会员到期行 */
.expire-line {
  margin: 12rpx 0 4rpx;
  padding: 12rpx 20rpx;
  background: #FDF8F0;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #6B5B5B;
}
.expire-line.warn {
  background: #fff3e0;
  color: #b45309;
  font-weight: 600;
}

/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */

/* 头部：水彩渐变 + 头像贴纸 */
.profile-header {
  background: linear-gradient(135deg, var(--accent-soft), var(--sun-soft) 55%, var(--sakura-soft));
  border-bottom: 3rpx solid var(--fg);
  padding-bottom: 44rpx;
}
.profile-header .profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid var(--fg);
  border-radius: 50%;
  box-shadow: var(--shadow-hard);
  background: var(--sun-soft);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-header .profile-name {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 36rpx;
  color: var(--fg);
}

/* 卡片：粗黑边 + 手绘圆角 + 硬阴影 */
.section-card {
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 32rpx 36rpx 28rpx 40rpx;
  box-shadow: var(--shadow-hard-sm);
}

/* 标题圆体 + 橙块装饰 */
.section-title {
  font-family: var(--font-display);
  font-weight: 800;
  color: var(--fg);
}
.section-title::before {
  content: "";
  display: inline-block;
  width: 14rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: var(--accent);
  border: 2rpx solid var(--fg);
  margin-right: 12rpx;
  vertical-align: -2rpx;
}

/* 功能宫格：彩色圆贴纸图标（覆盖旧 nth-child 灰绿系） */
.func-item .fi-icon {
  width: 88rpx;
  height: 88rpx;
  border: 3rpx solid var(--fg);
  border-radius: 50%;
  box-shadow: 3rpx 3rpx 0 rgba(59, 47, 47, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  transition: transform 0.12s ease;
}
.func-item:active .fi-icon {
  transform: scale(0.9);
}
/* 绘本多色轮换（色彩超过 5 个自动循环感：橙绿蓝金粉紫） */
.func-item:nth-child(6n+1) .fi-icon { background: var(--accent-soft); }
.func-item:nth-child(6n+2) .fi-icon { background: var(--secondary-soft); }
.func-item:nth-child(6n+3) .fi-icon { background: var(--sky-soft); }
.func-item:nth-child(6n+4) .fi-icon { background: var(--sun-soft); }
.func-item:nth-child(6n+5) .fi-icon { background: var(--sakura-soft); }
.func-item:nth-child(6n+6) .fi-icon { background: var(--lavender-soft); }

/* 功能名圆体 */
.func-item .fi-label {
  font-weight: 700;
}

/* 孩子切换 chip 贴纸化 */
.child-switcher-chip {
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: var(--shadow-hard-sm);
  font-weight: 700;
}
.child-switcher-chip.active {
  background: var(--sun);
  color: var(--fg);
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(59, 47, 47, 0.85);
}

/* 退出登录行：纸面粗边 */
.bottom-links .link-item {
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}

/* ============================================
   我的页 v4 改造（2026-08-30）：紧凑布局 + 减少留白
   ============================================ */

.page-bg {
  height: 100vh;
  background: var(--bg);
}

.profile-header {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--accent-soft), var(--sun-soft) 55%, var(--sakura-soft));
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid var(--fg);
  border-radius: 50%;
  background: var(--sun-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  box-shadow: 3rpx 3rpx 0 rgba(59, 47, 47, 0.55);
}

.profile-name {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 800;
}

.profile-phone {
  font-size: 24rpx;
  color: var(--muted);
}

.profile-child {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--border);
}

.pc-name {
  font-size: 26rpx;
  font-weight: 700;
}

.pc-status {
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--surface);
  font-size: 22rpx;
  font-weight: 700;
}

.pc-status.warn {
  background: var(--error-soft);
  color: var(--error);
}

.section-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}

.section-card.no-padding {
  padding: 24rpx 0;
}

.section-card.no-padding .section-title {
  padding: 0 24rpx;
}

.section-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title::before {
  content: "";
  width: 10rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: var(--accent);
  border: 2rpx solid var(--fg);
}

.child-switcher-scroll {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  overflow-x: auto;
  scrollbar-width: none;
}

.child-switcher-scroll::-webkit-scrollbar {
  display: none;
}

.child-switcher-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: var(--shadow-hard-sm);
}

.child-switcher-chip.active {
  background: var(--sun);
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 rgba(59, 47, 47, 0.85);
}

.chip-avatar {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid var(--fg);
  border-radius: 50%;
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 700;
}

.chip-text {
  font-weight: 700;
  font-size: 26rpx;
}

.chip-status {
  font-size: 20rpx;
  color: var(--muted);
}

.member-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mi-item {
  flex: 1;
  min-width: calc(50% - 16rpx);
  padding: 16rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
}

.mi-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.mi-value {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.mi-value.warn {
  color: var(--error);
}

.func-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.func-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 6rpx;
}

.fi-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
  border: 3rpx solid var(--fg);
  border-radius: 22rpx;
  background: var(--surface);
  box-shadow: 3rpx 3rpx 0 rgba(59, 47, 47, 0.55);
}

.func-item:nth-child(6n+1) .fi-icon { background: var(--accent-soft); }
.func-item:nth-child(6n+2) .fi-icon { background: var(--secondary-soft); }
.func-item:nth-child(6n+3) .fi-icon { background: var(--sky-soft); }
.func-item:nth-child(6n+4) .fi-icon { background: var(--sun-soft); }
.func-item:nth-child(6n+5) .fi-icon { background: var(--sakura-soft); }
.func-item:nth-child(6n+6) .fi-icon { background: var(--lavender-soft); }

.fi-label {
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.bottom-links {
  margin: 0 24rpx 24rpx;
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}

.link-item.logout {
  background: var(--error-soft);
}

.lk-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lk-icon {
  font-size: 36rpx;
}

.lk-text {
  font-size: 28rpx;
  font-weight: 700;
}

.lk-arrow {
  font-size: 34rpx;
  color: var(--muted);
  font-weight: 700;
}

.bottom-spacer {
  height: 160rpx;
}
