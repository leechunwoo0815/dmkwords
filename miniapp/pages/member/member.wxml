<scroll-view class="page-bg" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="profile-header">
    <view class="profile-main">
      <view bindtap="openAvatarPicker">
        <avatar-ring size="104"
          src="{{currentChild && currentChild.avatar ? '/icons/avatars/' + currentChild.avatar + '.png' : '/icons/avatars/cat_sun.png'}}"
          level="{{currentChild.level}}" />
      </view>
      <view class="profile-info">
        <view class="profile-name" bindtap="onEditDisplayName">
          {{parent.display_name || parent.name || '家长'}}
          <text class="profile-edit">✏️</text>
        </view>
        <view class="profile-phone">{{parent.phone || '已登录'}}</view>
      </view>
    </view>
    <view wx:if="{{currentChild}}" class="profile-child">
      <text class="pc-name">正在陪伴：{{currentChild.name}}</text>
      <text class="pc-status {{expireWarn ? 'warn' : ''}}">{{statusText}}</text>
    </view>
  </view>

  <!-- WM15-R3：内置头像宫格选择 -->
  <view wx:if="{{showAvatarPicker}}" class="avatar-mask" bindtap="closeAvatarPicker">
    <view class="avatar-panel" catchtap="noop">
      <view class="avatar-panel-title">选一个头像</view>
      <view class="avatar-grid">
        <view wx:for="{{avatarOptions}}" wx:key="id"
          class="avatar-cell {{item.active ? 'active' : ''}}"
          data-id="{{item.id}}" bindtap="onPickAvatar">
          <image class="avatar-cell-img" src="{{item.url}}" mode="aspectFill" />
        </view>
      </view>
      <view class="avatar-cancel" bindtap="closeAvatarPicker">取消</view>
    </view>
  </view>

  <view wx:if="{{children.length > 1}}" class="section-card no-padding">
    <view class="section-title">切换孩子</view>
    <view class="child-switcher-scroll">
      <view wx:for="{{children}}" wx:key="id"
        class="child-switcher-chip {{currentChild && currentChild.id === item.id ? 'active' : ''}}"
        data-id="{{item.id}}" bindtap="onSwitchChild">
        <text class="chip-avatar">{{item.name ? item.name[0] : '👶'}}</text>
        <text class="chip-text">{{item.name}}</text>
        <text class="chip-status">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{currentChild}}" class="section-card">
    <view class="section-title">会员信息</view>
    <view class="member-info-row">
      <view class="mi-item">
        <text class="mi-label">会员状态</text>
        <text class="mi-value {{expireWarn ? 'warn' : ''}}">{{statusText}}</text>
      </view>
      <view class="mi-item" wx:if="{{expireLine}}">
        <text class="mi-label">到期时间</text>
        <text class="mi-value {{expireWarn ? 'warn' : ''}}">{{expireLine}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">成长中心</view>
    <view class="func-grid">
      <view class="func-item" bindtap="goCheckin">
        <text class="fi-icon">📅</text>
        <text class="fi-label">打卡日历</text>
      </view>
      <view class="func-item" bindtap="goAchievement">
        <text class="fi-icon">🏆</text>
        <text class="fi-label">等级勋章</text>
      </view>
      <view class="func-item" bindtap="goPassport">
        <text class="fi-icon">🪪</text>
        <text class="fi-label">阅读护照</text>
      </view>
      <view class="func-item" bindtap="goReport">
        <text class="fi-icon">📊</text>
        <text class="fi-label">周报月报</text>
      </view>
      <view class="func-item" bindtap="goLeaderboard">
        <text class="fi-icon">🏅</text>
        <text class="fi-label">排行榜</text>
      </view>
      <view class="func-item" bindtap="goObservation">
        <text class="fi-icon">📋</text>
        <text class="fi-label">评估报告</text>
      </view>
      <view class="func-item" bindtap="goVocabulary">
        <text class="fi-icon">📖</text>
        <text class="fi-label">生词本</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">借阅服务</view>
    <view class="func-grid">
      <view class="func-item" bindtap="goReservation">
        <text class="fi-icon">🔖</text>
        <text class="fi-label">我的预约</text>
      </view>
      <view class="func-item" bindtap="goDeposit">
        <text class="fi-icon">💳</text>
        <text class="fi-label">押金</text>
      </view>
      <view class="func-item" bindtap="goOrders">
        <text class="fi-icon">📋</text>
        <text class="fi-label">我的订单</text>
      </view>
      <view class="func-item" bindtap="goRefund">
        <text class="fi-icon">💰</text>
        <text class="fi-label">退款申请</text>
      </view>
      <view class="func-item" bindtap="goTransfer">
        <text class="fi-icon">🔁</text>
        <text class="fi-label">权益转让</text>
      </view>
      <view class="func-item" bindtap="goMessages">
        <text class="fi-icon">🔔</text>
        <text class="fi-label">消息中心</text>
      </view>
    </view>
  </view>

  <view class="bottom-links">
    <view class="link-item logout" bindtap="onLogout">
      <view class="lk-left"><text class="lk-icon">🚪</text><text class="lk-text">退出登录</text></view>
      <text class="lk-arrow">›</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</scroll-view>
