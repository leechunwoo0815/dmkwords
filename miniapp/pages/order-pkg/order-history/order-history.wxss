/* order-history.wxss — aligned with design/user-end/order-history.html */

.page-bg {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* Nav Bar */
.nav-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-bar .back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 40rpx;
  color: var(--fg);
}

.nav-title,
.title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fg);
}

/* Tabs */
.tabs {
  display: flex;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  position: sticky;
  top: 96rpx;
  z-index: 9;
}

.tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
  font-weight: 500;
  position: relative;
}.tab.active{
  color: var(--accent);
}.tab.active::after{
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

/* Order List */
.order-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Order Card */
.order-card {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.order-id {
  font-family: var(--font-mono);
  font-size: 24rpx;
  color: var(--muted);
}

.order-status {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-paid {
  background: var(--success-soft);
  color: var(--success);
}

.badge-pending {
  background: var(--warning-soft);
  color: var(--warning);
}

.badge-refunded {
  background: var(--error-soft);
  color: var(--error);
}

.order-body {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.order-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.order-icon-img {
  width: 52rpx;
  height: 52rpx;
}
.order-icon-type3 {
  background: var(--accent-soft);
}

.order-icon-type2 {
  background: var(--secondary-soft);
}

.order-icon-type1 {
  background: var(--success-soft);
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.order-type {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--fg);
}

.order-time {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.order-amount {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
}

.order-amount-refund {
  text-decoration: line-through;
  color: var(--muted);
}

/* Order icon type aliases (matching prototype class names) */
.order-icon.course {
  background: var(--accent-soft);
}

.order-icon.observe {
  background: var(--secondary-soft);
}

.order-icon.member {
  background: var(--success-soft);
}



/* ===== 2026-09-13 内联样式迁移（机械生成，勿手改） ===== */
.x-245e15 { padding: 80rpx 0; text-align: center; color: var(--muted); font-size: 26rpx; }

/* ===== WM12-A：待支付订单「去支付」（iOS 不渲染该按钮，见 js 的 showPay） ===== */
.order-pay-row {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx 4rpx;
}
.order-pay-btn {
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--surface);
  font-size: 26rpx;
  font-weight: 700;
  border: 3rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
}

/* WM12-C（审查 P2-10）：请求期间按钮置灰 + 不响应（双击不再刷出两个预支付单） */
.order-pay-btn-busy {
  opacity: 0.6;
}

/* WM12-C（审查 P0-3）：未绑微信的登录态 → 不渲染「去支付」，给一键登录引导 */
.pay-hint {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--muted-light);
  color: var(--fg);
  font-size: 24rpx;
  line-height: 1.6;
  border: 3rpx dashed var(--fg);
}
