<view class="page-bg">
  <!-- Nav Bar -->
  <view class="nav-bar">
    <view class="back" bindtap="onBack">‹</view>
    <view class="nav-title">我的订单{{childName ? ' · ' + childName : ''}}</view>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}" bindtap="onTab">{{item.label}}</view>
  </view>

  <!-- WM12-C（审查 P0-3）：不能线上支付时说明原因 -->
  <view class="pay-hint" wx:if="{{payHint}}">{{payHint}}</view>

  <!-- Order List -->
  <!-- P2-45：失败态显式呈现（原先失败静默 → 渲染成"暂无订单"） -->
  <error-view wx:if="{{loadError}}" type="network" title="订单加载失败"
    desc="{{loadError}}（订单未加载，不代表没有订单）" bind:onRetry="onRetryLoad" />

  <view class="order-list" wx:if="{{!loadError && filtered.length}}">
    <view wx:for="{{filtered}}" wx:key="id" class="order-card">
      <view class="order-header">
        <text class="order-id">{{item.order_no}}</text>
        <text class="order-status badge-{{item.status === 'paid' ? 'paid' : item.status === 'refunded' ? 'refunded' : 'pending'}}">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <view class="order-icon {{item.iconCls}}">
          <image class="order-icon-img" src="{{item.iconUrl}}" mode="aspectFit" />
        </view>
        <view class="order-info">
          <view class="order-type">{{item.typeText}}</view>
          <view class="order-time">{{item.timeText}}</view>
          <view wx:if="{{item.refundText}}" class="order-amount-refund">{{item.refundText}}</view>
        </view>
        <view class="order-amount">￥{{item.amount}}</view>
      </view>
      <view class="order-pay-row" wx:if="{{showPay && item.payable}}">
        <view class="order-pay-btn {{paying ? 'order-pay-btn-busy' : ''}}" data-id="{{item.id}}" bindtap="onPay">去支付</view>
      </view>
    </view>
  </view>

  <view class="x-245e15" wx:elif="{{!loadError}}">
    暂无订单
  </view>
</view>
