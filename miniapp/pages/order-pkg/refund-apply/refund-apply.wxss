/* refund-apply.wxss — aligned with design/user-end/refund-apply.html */

.page-bg {
  background: var(--bg);
  min-height: 100vh;
  /* 2026-09-15：原 200rpx 是为「固定底栏」留的位；底栏已回文档流，改常规留白
     （200rpx 会留下大片无意义空白） */
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* Loading & Empty */
.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--muted);
  font-size: 28rpx;
}

.card-h3 {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--fg);
}

/* Selector */
.selector-card {
  margin: 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
}

.kv-label {
  color: var(--muted);
}

.kv-value {
  font-weight: 500;
  color: var(--fg);
}

/* Calc Card */
.calc-card {
  margin: 0 32rpx 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
}

.calc-desc {
  flex: 1;
  color: var(--muted);
}

.calc-result {
  margin-top: 16rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.calc-result-label {
  font-weight: 600;
  color: var(--fg);
}

.calc-result-amount {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--success);
}

/* Reason Card */
.reason-card {
  margin: 0 32rpx 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
}

.reason-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
  color: var(--fg);
  background: var(--bg);
}

.reason-textarea:focus {
  border-color: var(--accent);
}

/* Tip Card */
.tip-card {
  margin: 0 32rpx 32rpx;
  padding: 24rpx 32rpx;
  background: var(--warning-soft);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--warning);
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

/* Submit
   2026-09-15：本页 .submit-wrap 用在**卡片内部**（退款原因卡 + 退会卡各一个），
   但样式是从 HTML 稿搬来的 position:fixed 底栏 → 两个 fixed bottom:0 的提交区
   完全重叠（「申请退会」压住「提交退款申请」），且固定栏盖住页面最后的正文与
   输入区（用户实测：滑到底仍被遮）。它是卡片内的提交区，回到文档流即可。 */
.submit-wrap {
  margin-top: 24rpx;
}

.submit-wrap .btn-primary {
  width: 100%;
}

/* Info Card headings & row variants */

.info-row .label {
  color: var(--muted);
}

.info-row .value {
  font-weight: 500;
}

.info-row.total {
  border-top: 2rpx solid var(--border);
  margin-top: 8rpx;
  padding-top: 24rpx;
}

.info-row.total .value {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
}

.calc-step .dot.n {
  background: var(--accent-soft);
  color: var(--accent);
}

.calc-result .label {
  font-weight: 600;
  color: var(--fg);
}

.calc-result .amount {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--success);
}

/* Reason textarea placeholder */
.reason-textarea::placeholder {
  color: var(--muted);
}

/* Tip card text color (prototype uses specific muted warning) */
.tip-card .tip-text {
  color: var(--warning);
}

.btn-disabled {
  opacity: 0.5;
}button{
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  font-weight: 700;
}.btn-primary, button[type="primary"]{
  background: var(--accent);
  color: var(--surface);
}button:active{
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}.cell{
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}


/* 绘本风精修补充：选择卡与信息卡 */
.selector-card {
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}
.info-row:last-child {
  border-bottom: none;
}

/* W5 撤销申请按钮（对齐 secondary 胶囊贴纸风） */
.cancel-refund-btn {
  background: var(--surface);
  color: var(--warning-dark, var(--warning));
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  line-height: 1.6;
}

/* X6 三形态卡片 */
.calc-detail {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.calc-arrow {
  color: var(--warning);
}
.calc-zero-label {
  color: var(--error);
}
.calc-zero-reason {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
  display: block;
}

/* R1：zero 模式禁提交 */
.zero-tip {
  font-size: 22rpx;
  color: var(--error);
  margin-top: 10rpx;
  text-align: center;
}


