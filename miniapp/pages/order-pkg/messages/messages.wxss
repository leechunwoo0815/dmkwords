/* messages.wxss — 消息中心 v5：卡片化列表 */
.page-bg {
  background: var(--bg);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- 分类 chips ---------- */
/* 2026-09-15：分类共 8 个（全部/资金/借阅/阅读/会员/活动/预约/报告），
   一行横排必然溢出——即便收到最窄，最后 1~2 个 chip 也会被切到只剩半个字，
   看着像布局坏了（用户视角）。改成 4×2 网格：8 个分类全部可见、无横滑歧义。 */
.cat-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0 20rpx;
}
.cat-tab {
  /* 25% - 9rpx 会算成正好等于容器宽，浮点误差把第 4 个挤到下一行（3+3+2）；
     -10rpx 留 4rpx 余量 → 稳定 4+4 */
  flex: 0 0 calc(25% - 10rpx);
  box-sizing: border-box;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  font-size: 26rpx;
  color: var(--muted);
  font-weight: 600;
}
.cat-tab.active {
  background: var(--accent);
  border-color: var(--fg);
  color: var(--surface);
  box-shadow: var(--shadow-hard-sm);
}

/* ---------- 未读操作条 ---------- */
.unread-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--accent-soft);
  border: 3rpx solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}
.unread-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--fg);
  font-size: 26rpx;
}
.unread-num {
  background: var(--accent);
  color: var(--surface);
  font-size: 22rpx;
  font-weight: 800;
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}
.unread-all { color: var(--accent); font-size: 26rpx; font-weight: 700; }

/* ---------- 消息卡片 ---------- */
.msg-list { display: flex; flex-direction: column; gap: 16rpx; }
.msg-card {
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 22rpx 24rpx;
}
.msg-card.is-read { opacity: 0.72; box-shadow: none; border-color: var(--border); }
.msg-head { display: flex; align-items: center; gap: 12rpx; }
.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}
.msg-cat-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
}
.cat-money { background: var(--success-soft); color: var(--success); }
.cat-borrow { background: var(--sky-soft); color: var(--sky); }
.cat-member { background: var(--lavender-soft); color: var(--lavender); }
.cat-activity { background: var(--sakura-soft); color: var(--sakura); }
.msg-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.is-read .msg-title { font-weight: 600; }
.msg-time { flex-shrink: 0; font-size: 20rpx; color: var(--muted); }
.msg-content {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}
.msg-content.one-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg-content.expanded { color: var(--fg); }

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: var(--muted);
  font-size: 28rpx;
}
.load-end { text-align: center; color: var(--muted); font-size: 22rpx; padding: 32rpx 0; }

/* WM15-R6：通知深链入口（circle.liked → 名片页） */
.msg-ref {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-light);
}

.list-error { text-align: center; padding: 80rpx 32rpx; color: var(--accent); font-size: 28rpx; }
