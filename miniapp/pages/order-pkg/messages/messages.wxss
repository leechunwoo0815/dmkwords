/* messages.wxss — 消息中心 v5：卡片化列表 */
.page-bg {
  background: var(--bg);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- 分类 chips ---------- */
.cat-tabs {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding: 4rpx 2rpx 20rpx;
  white-space: nowrap;
}
.cat-tab {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  font-size: 26rpx;
  color: var(--muted);
  font-weight: 600;
}
.cat-tab.active {
  background: var(--accent);
  border-color: var(--fg);
  color: #fff;
  box-shadow: var(--shadow-hard-sm);
}

/* ---------- 未读操作条 ---------- */
.unread-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--accent-soft);
  border: 3rpx solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}
.unread-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--fg);
  font-size: 26rpx;
}
.unread-num {
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
}
.unread-all { color: var(--accent); font-size: 26rpx; font-weight: 700; }

/* ---------- 消息卡片 ---------- */
.msg-list { display: flex; flex-direction: column; gap: 16rpx; }
.msg-card {
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 22rpx 24rpx;
}
.msg-card.is-read { opacity: 0.72; box-shadow: none; border-color: var(--border); }
.msg-head { display: flex; align-items: center; gap: 12rpx; }
.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}
.msg-cat-tag {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
}
.cat-money { background: rgba(74, 222, 128, 0.16); color: var(--success); }
.cat-borrow { background: rgba(96, 165, 250, 0.16); color: var(--sky); }
.cat-member { background: rgba(167, 139, 250, 0.16); color: var(--lavender); }
.cat-activity { background: rgba(244, 114, 182, 0.16); color: var(--sakura); }
.msg-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.is-read .msg-title { font-weight: 600; }
.msg-time { flex-shrink: 0; font-size: 20rpx; color: var(--muted); }
.msg-content {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}
.msg-content.one-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg-content.expanded { color: var(--fg); }

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  color: var(--muted);
  font-size: 28rpx;
}
.load-end { text-align: center; color: var(--muted); font-size: 22rpx; padding: 32rpx 0; }
