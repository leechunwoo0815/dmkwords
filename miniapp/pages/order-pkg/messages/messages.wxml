<view class="page-bg">
  <!-- 分类 chips -->
  <view class="cat-tabs">
    <view wx:for="{{categories}}" wx:key="key"
      class="cat-tab {{activeCat === item.key ? 'active' : ''}}"
      data-key="{{item.key}}" bindtap="switchCat">
      {{item.label}}
    </view>
  </view>

  <!-- 未读操作条 -->
  <view class="unread-bar" wx:if="{{unread > 0}}" bindtap="markAllRead">
    <view class="unread-left">
      <text class="unread-num">{{unread}}</text>
      <text>条未读消息</text>
    </view>
    <text class="unread-all">全部已读 ›</text>
  </view>

  <view wx:if="{{loading && list.length === 0}}" class="loading">加载中…</view>
  <view wx:elif="{{error && list.length === 0}}" class="list-error" bindtap="onPullDownRefresh">加载失败，点此重试</view>
  <empty-state wx:elif="{{list.length === 0}}" icon-name="bell" title="暂无消息" desc="有新消息时会第一时间通知你" />

  <view class="msg-list" wx:else>
    <view wx:for="{{list}}" wx:key="id"
      class="msg-card {{item.read ? 'is-read' : ''}}"
      data-id="{{item.id}}" bindtap="toggleExpand">
      <view class="msg-head">
        <view wx:if="{{!item.read}}" class="unread-dot"></view>
        <text class="msg-cat-tag cat-{{item.catKey}}">{{item.categoryLabel}}</text>
        <text class="msg-title">{{item.title}}</text>
        <text class="msg-time">{{item.timeText}}</text>
      </view>
      <!-- P3（第一百一十三批）：原先第二个 `wx:else` 挂在「有 ref 才显示」的那条 `wx:if` 上，
           于是「展开但没有 ref」的消息会**同时渲染 expanded 与 one-line 两份正文**。
           改成显式条件：未展开才渲染单行摘要。 -->
      <view wx:if="{{expandedId === item.id}}" class="msg-content expanded">{{item.content}}</view>
      <view wx:if="{{expandedId === item.id && item.ref}}" class="msg-ref"
        data-ref="{{item.ref}}" catchtap="onGoRef">{{item.ref.label}}</view>
      <view wx:if="{{expandedId !== item.id}}" class="msg-content one-line">{{item.content}}</view>
    </view>
  </view>

  <!-- W7-01（第十轮 P2）：刷新/翻页失败的行内提示（列表还在、不清空；原先这种情况**零反馈**） -->
  <view wx:if="{{listError}}" class="load-error" bindtap="onRetryMore">{{listError}}，点此重试</view>

  <view wx:if="{{list.length > 0 && list.length >= total}}" class="load-end">— 没有更多了 —</view>
</view>
