<view class="page x-faa900">
  <view class="tip-card">
    <image class="tip-icon" src="/icons/ui/tip.png" mode="aspectFit" />
    <text class="tip-text">把大孩的会员剩余时间转给二孩：年度会员服务费不退、到期日直接继承；词数/等级/积分/打卡各是各的（排行榜不失真）。押金不转，各缴各的。</text>
  </view>

  <view class="transfer-card">
    <view class="transfer-heading">选择转出方（大孩）</view>
    <view class="child-select">
      <view wx:for="{{children}}" wx:key="id"
        class="check-item {{sourceId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}" bindtap="onPickSource">
        <view class="name">{{item.name}}</view>
        <view class="meta">{{item.memberLabel}}</view>
        <view class="check-circle">{{sourceId === item.id ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="arrow-section"><image class="arrow-icon" src="/icons/ui/arrow-down.png" mode="aspectFit" /></view>

    <view class="transfer-heading">选择受让方（二孩）</view>
    <view class="child-select">
      <view wx:for="{{children}}" wx:key="id"
        class="check-item {{targetId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}" bindtap="onPickTarget">
        <view class="name">{{item.name}}</view>
        <view class="meta">{{item.memberLabel}}</view>
        <view class="check-circle">{{targetId === item.id ? '✓' : ''}}</view>
      </view>
    </view>
  </view>

  <!-- P2-16（第九轮审查）：条件查询失败与"条件不全"必须分开——失败时原先只剩一句
       "条件不全，暂不能提交"，等于把网络故障读成家长自己的条件问题 -->
  <view class="check-list" wx:if="{{condError}}">
    <view class="check-heading">转让条件核对</view>
    <view class="check-item">
      <text class="check-text">条件查询失败：{{condError}}</text>
    </view>
    <view class="check-item">
      <text class="check-text">这不代表条件不满足——请重试；若一直失败可联系馆员。</text>
    </view>
    <view class="submit-wrap">
      <button class="btn-primary" bindtap="onRetryCheck">重试查询</button>
    </view>
  </view>

  <view class="check-list" wx:elif="{{conditions}}">
    <view class="check-heading">转让条件核对</view>
    <view wx:for="{{conditions}}" wx:key="name" class="check-item">
      <view class="check-icon-wrap {{item.ok ? 'pass' : 'fail'}}">
        <text class="check-result-icon">{{item.ok ? '✓' : '✕'}}</text>
      </view>
      <text class="check-text">{{item.name}}</text>
    </view>
    <view class="submit-wrap" wx:if="{{conditions.length}}">
      <button class="btn-primary" bindtap="onSubmit" disabled="{{!allOk}}">
        {{allOk ? '提交转让申请' : '条件不全，暂不能提交'}}
      </button>
    </view>
  </view>

  <!-- 第一百三十四批：转让记录加载失败必须可见（原先静默丢列表 = 与"没有记录"同形） -->
  <error-view wx:if="{{listError}}" type="network" title="转让记录加载失败"
    desc="{{listError}}（记录未加载，不代表没有转让记录）" bind:onRetry="onRetryList" />

  <view class="records-section" wx:if="{{!listError && records.length}}">
    <view class="records-heading">转让记录</view>
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="record-header">
        <text>{{item.source_name}} → {{item.target_name}}</text>
        <text class="record-status">{{item.status === 'pending' ? '审核中' : item.status === 'approved' ? '已通过' : item.status === 'rejected' ? '已拒绝' : item.status === 'expired' ? '已超时' : '已撤销'}}</text>
      </view>
      <view class="record-meta">
        <text>截止 {{item.expires_at}}</text>
        <text wx:if="{{item.status === 'pending'}}" class="record-arrow cancel" data-id="{{item.id}}" bindtap="onCancel">撤销</text>
      </view>
      <view wx:if="{{item.review_remark}}" class="record-meta">审核意见：{{item.review_remark}}</view>
    </view>
  </view>
</view>
