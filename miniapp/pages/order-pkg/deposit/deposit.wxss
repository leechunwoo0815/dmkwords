/* pages/order-pkg/deposit/deposit.wxss — 押金页（风格对齐 report 页） */
.dp-head {
  background: var(--accent);
  border-radius: 16rpx;
  padding: 24rpx;
  color: var(--surface);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dp-title {
  font-size: 32rpx;
  font-weight: 600;
}
.dp-status {
  font-size: 22rpx;
  color: var(--border);
}
.dp-amounts {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.dp-amt {
  flex: 1;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.dp-num {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--success);
}
.dp-label {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.dp-balance {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--warning);
}
.dp-btn {
  margin-top: 20rpx;
  background: var(--accent);
  color: var(--surface);
  border-radius: 999rpx;
  font-size: 28rpx;
}
.dp-btn.disabled {
  background: var(--border);
  color: var(--muted-light);
}
.dp-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted-light);
  text-align: center;
}
.dp-empty {
  color: var(--muted-light);
  font-size: 26rpx;
  padding: 30rpx 0;
  text-align: center;
}
.dp-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--border);
}
.dp-row-left {
  flex: 1;
}
.dp-row-type {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}
.dp-row-type.red {
  color: var(--warning);
}
.dp-row-reason {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.dp-row-time {
  font-size: 20rpx;
  color: var(--muted-light);
  margin-top: 4rpx;
}
.dp-row-right {
  text-align: right;
}
.dp-row-amount {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--success);
}
.dp-row-amount.red {
  color: var(--warning);
}
.dp-row-balance {
  display: block;
  font-size: 20rpx;
  color: var(--muted-light);
  margin-top: 4rpx;
}.section-card{
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}button{
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  font-weight: 700;
}button[type="primary"]{
  background: var(--accent);
  color: var(--surface);
}button:active{
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}.title, .name{
  font-family: var(--font-display);
  font-weight: 700;
}


/* 绘本风精修补充：押金头部与金额小卡 */
.dp-head {
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
}
.dp-title {
  font-family: var(--font-display);
  font-weight: 800;
}
.dp-amt {
  border: 2rpx solid var(--fg);
  border-radius: 20rpx 24rpx 18rpx 26rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}
.dp-num {
  font-family: var(--font-display);
  font-weight: 800;
}


