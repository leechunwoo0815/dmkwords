/* pages/order-pkg/deposit/deposit.wxss — 押金页（风格对齐 report 页） */
.dp-head {
  background: #2c4a6e;
  border-radius: 16rpx;
  padding: 24rpx;
  color: #fffefa;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dp-title {
  font-size: 32rpx;
  font-weight: 600;
}
.dp-status {
  font-size: 22rpx;
  color: #e4dcc8;
}
.dp-amounts {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.dp-amt {
  flex: 1;
  background: #f6f2e9;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.dp-num {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #35703c;
}
.dp-label {
  display: block;
  font-size: 20rpx;
  color: #6f685a;
  margin-top: 6rpx;
}
.dp-balance {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b45309;
}
.dp-btn {
  margin-top: 20rpx;
  background: #2c4a6e;
  color: #fffefa;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.dp-btn.disabled {
  background: #d8d2c2;
  color: #8a8375;
}
.dp-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a39a86;
  text-align: center;
}
.dp-empty {
  color: #a39a86;
  font-size: 26rpx;
  padding: 30rpx 0;
  text-align: center;
}
.dp-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e4dcc8;
}
.dp-row-left {
  flex: 1;
}
.dp-row-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c4a6e;
}
.dp-row-type.red {
  color: #b45309;
}
.dp-row-reason {
  font-size: 22rpx;
  color: #6f685a;
  margin-top: 4rpx;
}
.dp-row-time {
  font-size: 20rpx;
  color: #a39a86;
  margin-top: 4rpx;
}
.dp-row-right {
  text-align: right;
}
.dp-row-amount {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #35703c;
}
.dp-row-amount.red {
  color: #b45309;
}
.dp-row-balance {
  display: block;
  font-size: 20rpx;
  color: #a39a86;
  margin-top: 4rpx;
}
