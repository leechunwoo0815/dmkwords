/* reservation.wxss — aligned with design/user-end/reservation.html */

.page-bg {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.nav-bar .title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fg);
}

/* Tip Banner */
.tip-banner {
  margin: 16rpx 32rpx 32rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
  font-size: 26rpx;
  color: var(--accent);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  line-height: 1.5;
}

.tip-banner .tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

/* Section Labels */
.section-label {
  padding: 28rpx 32rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* Reservation List */
.reservation-list {
  padding: 0 32rpx;
}

/* Reservation Card */
.reservation-card {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 24rpx;
}

/* Info */
.reservation-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.reservation-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reservation-author {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.reservation-time {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

/* Countdown Row */
.countdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

/* Countdown Badge */
.countdown {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.countdown.urgent {
  background: var(--error-soft);
  color: var(--error);
}

.countdown.normal {
  background: var(--success-soft);
  color: var(--success);
}

.countdown .clock {
  font-size: 28rpx;
}

/* Reservation Actions */
.reservation-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

/* Cancel Button */
.cancel-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid var(--border);
  color: var(--muted);
  background: var(--surface);
  min-height: initial;
  line-height: 1.5;
}

.cancel-btn::after {
  border: none;
}

.cancel-btn:active {
  border-color: var(--error);
  color: var(--error);
  background: var(--error-soft);
}

/* Expired Card */
.reservation-card.expired {
  opacity: 0.55;
}

/* Expired Badge */
.expired-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 600;
}

/* Queue Badge */
.queue-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--warning-soft);
  color: var(--warning-dark);
  font-size: 24rpx;
  font-weight: 600;
}

/* Loading State */
.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: var(--muted);
  font-size: 28rpx;
}

/* Safe Bottom */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}button{
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  font-weight: 700;
}button[type="primary"]{
  background: var(--accent);
  color: var(--surface);
}button:active{
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}.title, .name{
  font-family: var(--font-display);
  font-weight: 700;
}.item, .cell{
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}/* 列表容器：加间距 */
.list{
  gap: 16rpx;
}

