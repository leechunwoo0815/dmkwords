<view class="page-bg">
  <view class="section-label">{{childName}} 的预约</view>

  <error-view wx:if="{{noChild}}" type="empty" title="还没有选择孩子"
    desc="请先在「我的」里添加或选择孩子，再来查看预约" showRetry="{{false}}" />

  <error-view wx:if="{{loadError}}" type="network" title="预约加载失败"
    desc="{{loadError}}（列表未加载，不代表没有数据）" bind:onRetry="onRetryLoad" />

  <view wx:if="{{loading && !noChild && !loadError}}" class="loading-state">加载中…</view>

  <empty-state wx:if="{{!loading && !noChild && !loadError && !items.length}}" icon-name="bookmark" title="还没有预约"
    desc="在图书馆里选一本书，点「预约此书」，副本会为你保留 {{cfg.reservation_hours}} 小时" />

  <view class="reservation-list">
    <view wx:for="{{items}}" wx:key="id" class="reservation-card">
      <view class="reservation-info">
        <view class="reservation-title">{{item.title}}</view>
        <view class="reservation-author">{{item.author || '佚名'}}</view>
        <!-- P3（第一百一十三批）：`expires_at` 是**到期时间**，原写「预约于」语义相反 -->
        <view class="reservation-time">保留至 {{item.expires_at}}</view>
        <view wx:if="{{item.remainText}}" class="countdown-row">
          <text class="countdown">{{item.remainText}}</text>
        </view>
        <view wx:if="{{item.status === 'checked_out'}}" class="queue-badge">已到店借出</view>
        <view wx:if="{{item.status === 'expired'}}" class="expired-badge">超时已释放</view>
        <view wx:if="{{item.status === 'cancelled'}}" class="expired-badge">已取消</view>
      </view>
      <view class="reservation-actions" wx:if="{{item.canCancel}}">
        <view class="cancel-btn" data-id="{{item.id}}" bindtap="onCancel">取消预约</view>
      </view>
    </view>
  </view>

  <view wx:if="{{items.length}}" class="tip-banner">
    预约副本保留 {{cfg.reservation_hours}} 小时；到店后请馆员在借阅台核销转借阅
  </view>
  <view class="safe-bottom"></view>
</view>
