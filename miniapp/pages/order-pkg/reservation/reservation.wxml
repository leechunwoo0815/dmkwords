<view class="page-bg">
  <view class="section-label">{{childName}} 的预约</view>

  <error-view wx:if="{{noChild}}" type="empty" title="还没有选择孩子"
    desc="请先在「我的」里添加或选择孩子，再来查看预约" showRetry="{{false}}" />

  <error-view wx:if="{{loadError}}" type="network" title="预约加载失败"
    desc="{{loadError}}（列表未加载，不代表没有数据）" bind:onRetry="onRetryLoad" />

  <view wx:if="{{loading && !noChild && !loadError}}" class="loading-state">加载中…</view>

  <empty-state wx:if="{{!loading && !noChild && !loadError && !items.length}}" icon-name="bookmark" title="还没有预约"
    desc="在阅读空间里选一本书，点「预约此书」，副本会为你保留 {{cfg.reservation_hours}} 小时" />

  <view class="reservation-list">
    <view wx:for="{{items}}" wx:key="id" class="reservation-card">
      <view class="reservation-info">
        <view class="reservation-title">{{item.title}}</view>
        <view class="reservation-author">{{item.author || '佚名'}}</view>
        <!-- P3（第一百一十三批）：`expires_at` 是**到期时间**，原写「预约于」语义相反 -->
        <!-- 第一百三十五批：只对**锁定中/已超时**显示「保留至」——已借出/已取消/副本异常
             再挂时间会被读成"还在保留"（状态由下方徽标表达） -->
        <view wx:if="{{item.status === 'active' || item.status === 'expired'}}" class="reservation-time">保留至 {{item.expires_at}}</view>
        <view wx:if="{{item.remainText}}" class="countdown-row">
          <text class="countdown">{{item.remainText}}</text>
        </view>
        <!-- P3（第一百一十六批）：这几支原先**永远不可达**——后端 `list_mine` 只回 active，
             而 docs/04 S35 的验收点写的是「家长端我的预约显示**已核销**」（核销后预约直接从
             列表消失 = 家长以为记录丢了）。本批改走 `include_closed=true` 这几支才真会渲染；
             文案统一取 `statusText`（唯一映射源在 js 的 STATUS_TEXT，不在 wxml 再抄一份） -->
        <view wx:if="{{item.status === 'checked_out'}}" class="queue-badge">{{item.statusText}}</view>
        <view wx:elif="{{item.status === 'exception'}}" class="queue-badge">{{item.statusText}}</view>
        <view wx:elif="{{item.status === 'expired'}}" class="expired-badge">{{item.statusText}}</view>
        <view wx:elif="{{item.status === 'cancelled'}}" class="expired-badge">{{item.statusText}}</view>
      </view>
      <view class="reservation-actions" wx:if="{{item.canCancel}}">
        <view class="cancel-btn" data-id="{{item.id}}" bindtap="onCancel">取消预约</view>
      </view>
    </view>
  </view>

  <!-- P3（第一百一十六批）：含历史时后端有 50 条上限（`X-List-Truncated` 响应头下发），
       截断必须如实说明，不能让家长以为"我一共就这些预约" -->
  <view class="list-hint" wx:if="{{!loading && !loadError && truncated}}">
    仅显示最近 {{historyLimit}} 条预约记录，可能还有更早的未列出
  </view>

  <view wx:if="{{items.length}}" class="tip-banner">
    预约副本保留 {{cfg.reservation_hours}} 小时；到店后请馆员在借阅台核销转借阅
  </view>
  <view class="safe-bottom"></view>
</view>
