/* login.wxss — aligned with design/user-end/login.html */

.login-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.logo-area {
  text-align: center;
  margin-bottom: 96rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin: 0 auto 32rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(var(--fg-rgb), 0.25);
}

.logo-emoji {
  font-size: 80rpx;
}

.app-name {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent);
}

.app-slogan {
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.member-only-tip {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 16rpx;
  padding: 0 40rpx;
  line-height: 1.5;
}

.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 0 24rpx;
  border: 2rpx solid var(--border);
  height: 88rpx;
}
.input-row.grow {
  flex: 1;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  background: transparent;
  border: none;
  outline: none;
  color: var(--fg);
}

.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.sms-row .input-row {
  flex: 1;
}

.phone-login-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--surface);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.4;
  min-height: auto;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn.disabled {
  opacity: 0.5;
}

.agreement-link {
  color: var(--accent);
  text-decoration: underline;
}

.agreement-link:active {
  opacity: 0.7;
}


/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */

/* Logo：太阳黄贴纸 + 轻摆动 */
.logo-area .logo-icon {
  border: 4rpx solid var(--fg);
  border-radius: 24rpx 28rpx 22rpx 30rpx;
  box-shadow: var(--shadow-hard);
  background: var(--sun);
  animation: paint-wiggle 3.5s ease-in-out infinite;
}
.app-name {
  font-family: var(--font-display);
  font-weight: 800;
}
.app-slogan {
  color: var(--muted);
}

/* 合规入口（2026-09-13）：登录即同意协议（仅入口，不做勾选门禁——F3 同意流待拍板） */
.agreement-row {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}
.agreement-link {
  color: var(--accent);
  text-decoration: underline;
}

.logo-emoji { width: 72rpx; height: 72rpx; }
.input-icon { width: 34rpx; height: 34rpx; }

/* 登录页三态（2026-10-08 接线：微信主通道 / 首次绑定 / 短信兜底） */
.wechat-login-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--surface);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
  min-height: auto;
}

.wechat-login-btn::after {
  border: none;
}

.mode-tip {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.6;
}

.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-btn {
  flex: none;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  border: 2rpx solid var(--accent);
  color: var(--accent);
  font-size: 26rpx;
}

.code-btn.disabled {
  opacity: 0.4;
}

.alt-row {
  text-align: center;
}

.alt-link {
  font-size: 26rpx;
  color: var(--accent);
  text-decoration: underline;
}

/* P2-52：登录失败提示（页面内留痕，不只靠 2 秒 toast） */
.login-error {
  margin: 24rpx 48rpx 0;
  padding: 16rpx 24rpx;
  background: var(--error-soft);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--danger, #cf1322);
  text-align: center;
}

/* 2026-11-12 审核驳回整改：页内失败态 / 演示入口 / 隐私拒绝后的固定出路 */

/* 页内失败态：网络或接口失败时留在页面上（原先只有 3 秒 toast，审核员只看到"页面没内容"） */
.net-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--error-soft);
  border-radius: 12rpx;
}
.net-error-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--danger, #cf1322);
  line-height: 1.5;
}
.net-error-retry {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
  padding: 4rpx 12rpx;
}

/* 演示入口：次要按钮（描边），不与主登录按钮抢视觉 */
.demo-login-btn {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx; /* 与「微信一键登录」同高（28rpx），两个按钮视觉成对 */
  border-radius: var(--radius);
  background: transparent;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid var(--accent);
  line-height: 1.4;
  min-height: auto;
  /* 单行：字号 30rpx 的 8 个字在 327px 内容宽里放得下，但仍显式禁止折行——
     2026-11-14 用户真机/模拟器截图里「体验一下（仅可浏览）」被折成两行 */
  white-space: nowrap;
  word-break: keep-all;
  display: flex;
  align-items: center;
  justify-content: center;
}
.demo-login-btn::after {
  border: none;
}

/* 隐私被拒绝：说明 + 三个出口（重试 / 体验 / 退出） */
.privacy-blocked {
  padding: 24rpx;
  background: var(--error-soft);
  border-radius: var(--radius);
}
.privacy-blocked-text {
  font-size: 26rpx;
  color: var(--danger, #cf1322);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.privacy-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.privacy-btn {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: var(--radius);
  background: var(--bg);
  color: var(--fg);
  font-size: 28rpx;
  border: 2rpx solid var(--border);
  line-height: 1.4;
  min-height: auto;
}
.privacy-btn::after {
  border: none;
}
.privacy-btn {
  white-space: nowrap;
  word-break: keep-all;
}
.privacy-btn.primary {
  background: var(--accent); /* R6 口径：新代码用 --accent（--primary 是同一值的旧别名） */
  color: var(--surface);
  border-color: var(--accent);
}
.privacy-btn.ghost {
  background: transparent;
  color: var(--muted);
}
