/* login.wxss — aligned with design/user-end/login.html */

.login-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.logo-area {
  text-align: center;
  margin-bottom: 96rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin: 0 auto 32rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(var(--fg-rgb), 0.25);
}

.logo-emoji {
  font-size: 80rpx;
}

.app-name {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent);
}

.app-slogan {
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 0 24rpx;
  border: 2rpx solid var(--border);
  height: 88rpx;
}
.input-row.grow {
  flex: 1;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  background: transparent;
  border: none;
  outline: none;
  color: var(--fg);
}

.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.sms-row .input-row {
  flex: 1;
}

.phone-login-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--accent);
  color: var(--surface);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.4;
  min-height: auto;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn.disabled {
  opacity: 0.5;
}

.agreement-link {
  color: var(--accent);
  text-decoration: underline;
}

.agreement-link:active {
  opacity: 0.7;
}


/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */

/* Logo：太阳黄贴纸 + 轻摆动 */
.logo-area .logo-icon {
  border: 4rpx solid var(--fg);
  border-radius: 24rpx 28rpx 22rpx 30rpx;
  box-shadow: var(--shadow-hard);
  background: var(--sun);
  animation: paint-wiggle 3.5s ease-in-out infinite;
}
.app-name {
  font-family: var(--font-display);
  font-weight: 800;
}
.app-slogan {
  color: var(--muted);
}

/* 合规入口（2026-09-13）：登录即同意协议（仅入口，不做勾选门禁——F3 同意流待拍板） */
.agreement-row {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}
.agreement-link {
  color: var(--accent);
  text-decoration: underline;
}

.logo-emoji { width: 72rpx; height: 72rpx; }
.input-icon { width: 34rpx; height: 34rpx; }
