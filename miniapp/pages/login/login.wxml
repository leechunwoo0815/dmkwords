<view class="login-container">
  <view class="logo-area">
    <view class="logo-icon"><text class="logo-emoji">📚</text></view>
    <view class="app-name">DmkWords</view>
    <view class="app-slogan">分级阅读 · 听见成长</view>
  </view>

  <view class="login-form">
    <view class="input-row">
      <text class="input-icon">📱</text>
      <input class="input-field" type="number" maxlength="11" placeholder="家长手机号（到店建档）"
        value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="sms-row">
      <view class="input-row grow">
        <text class="input-icon">🔑</text>
        <input class="input-field" type="number" maxlength="4" placeholder="验证码（开发期 1234）"
          value="{{code}}" bindinput="onCodeInput" />
      </view>
    </view>
    <button class="phone-login-btn" bindtap="onLogin" disabled="{{submitting}}">
      {{submitting ? '登录中…' : '登录'}}
    </button>

  <view class="agreement-row">
    登录即代表同意
    <text class="agreement-link" bindtap="goServiceAgreement">《用户服务协议》</text>
    与
    <text class="agreement-link" bindtap="goPrivacy">《隐私政策》</text>
  </view>
  </view>
</view>
