<view class="login-container">
  <view class="logo-area">
    <view class="logo-icon"><image class="logo-emoji" src="/icons/ui/book.png" mode="aspectFit" /></view>
    <view class="app-name">DmkWords</view>
    <view class="app-slogan">亲子阅读 · 听见成长</view>
  </view>

  <view class="login-form">
    <!-- ① 微信一键登录（主通道） -->
    <block wx:if="{{mode === 'wechat'}}">
  <!-- P2-52：登录失败在页面内留痕（toast 会消失，家长回来能看到原因） -->
  <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
      <button class="wechat-login-btn" bindtap="onWechatLogin" disabled="{{submitting}}">
        {{submitting ? '登录中…' : '微信一键登录'}}
      </button>
      <view class="alt-row" wx:if="{{smsEnabled}}">
        <text class="alt-link" bindtap="switchToSms">用手机号验证码登录</text>
      </view>
    </block>

    <!-- ② 首次绑定手机号（微信已取到；2026-10-29 起短信退役，手机号用微信快速验证） -->
    <block wx:elif="{{mode === 'bind'}}">
      <view class="mode-tip">首次登录，请验证手机号完成绑定</view>
      <button class="wechat-login-btn" open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber" disabled="{{submitting}}">
        {{submitting ? '绑定中…' : '微信手机号快速验证'}}
      </button>
      <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
      <!-- 短信仍启用时才显示兼容绑定面板；SMS_ENABLED=false 时整块隐藏，不给假入口 -->
      <block wx:if="{{smsEnabled}}">
        <view class="mode-tip">或使用短信验证码绑定</view>
        <view class="input-row">
          <image class="input-icon" src="/icons/ui/phone.png" mode="aspectFit" />
          <input class="input-field" type="number" maxlength="11" placeholder="家长手机号（到店建档）"
            value="{{phone}}" bindinput="onPhoneInput" />
        </view>
        <view class="sms-row">
          <view class="input-row grow">
            <image class="input-icon" src="/icons/ui/key.png" mode="aspectFit" />
            <input class="input-field" type="number" maxlength="6" placeholder="短信验证码"
              value="{{code}}" bindinput="onCodeInput" />
          </view>
          <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
            {{countdown > 0 ? countdown + 's' : '获取验证码'}}
          </view>
        </view>
        <button class="phone-login-btn" bindtap="onBind" disabled="{{submitting}}">
          {{submitting ? '绑定中…' : '绑定并登录'}}
        </button>
      </block>
      <view class="mode-tip" wx:else>微信手机号验证失败时，请联系馆员在后台处理。</view>
      <view class="alt-row">
        <text class="alt-link" bindtap="switchToWechat">返回微信登录</text>
      </view>
    </block>

    <!-- ③ 短信兜底登录 -->
    <block wx:else>
      <view class="input-row">
        <image class="input-icon" src="/icons/ui/phone.png" mode="aspectFit" />
        <input class="input-field" type="number" maxlength="11" placeholder="家长手机号（到店建档）"
          value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="sms-row">
        <view class="input-row grow">
          <image class="input-icon" src="/icons/ui/key.png" mode="aspectFit" />
          <input class="input-field" type="number" maxlength="6" placeholder="短信验证码"
            value="{{code}}" bindinput="onCodeInput" />
        </view>
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
      <button class="phone-login-btn" bindtap="onSmsLogin" disabled="{{submitting}}">
        {{submitting ? '登录中…' : '登录'}}
      </button>
      <view class="alt-row">
        <text class="alt-link" bindtap="switchToWechat">用微信一键登录</text>
      </view>
    </block>

    <view class="agreement-row">
      登录即代表同意
      <text class="agreement-link" bindtap="goServiceAgreement">《用户服务协议》</text>
      与
      <text class="agreement-link" bindtap="goPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>
