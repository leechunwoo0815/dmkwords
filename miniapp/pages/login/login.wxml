<view class="login-container">
  <view class="logo-area">
    <view class="logo-icon"><image class="logo-emoji" src="/icons/ui/book.png" mode="aspectFit" /></view>
    <view class="app-name">DmkWords</view>
    <view class="app-slogan">亲子阅读 · 听见成长</view>
    <view class="member-only-tip">本小程序仅面向本店线下会员，需到店建档后使用</view>
  </view>

  <view class="login-form">
    <!-- 页内失败态（2026-11-12 审核驳回整改）：网络/接口失败不再是"只弹一条 3 秒 toast"，
         而是页面里留一条可见的说明 + 重试按钮（审核员看到的就是那条 toast 的页面）。 -->
    <view class="net-error" wx:if="{{netError}}">
      <text class="net-error-text">{{netError}}</text>
      <text class="net-error-retry" bindtap="retryNetwork">重试</text>
    </view>

    <!-- ① 手机号快捷登录（主通道；2026-11-22 去「微信」字样，审核要求不得混淆官方元素） -->
    <block wx:if="{{mode === 'wechat'}}">
  <!-- P2-52：登录失败在页面内留痕（toast 会消失，家长回来能看到原因） -->
  <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
      <button class="wechat-login-btn" bindtap="onWechatLogin" disabled="{{submitting}}">
        {{submitting ? '登录中…' : '手机号快捷登录'}}
      </button>
      <!-- 只读演示体验（2026-11-12）：审核员/潜在客户没有本店账号也能看到核心页面；
           服务端 DEMO_LOGIN_PHONE 关闭时 demoEnabled=false，这里整块不渲染。 -->
      <button class="demo-login-btn" wx:if="{{demoEnabled}}" bindtap="onDemoLogin" disabled="{{submitting}}">
        体验一下（只读）
      </button>
      <view class="alt-row" wx:if="{{smsEnabled}}">
        <text class="alt-link" bindtap="switchToSms">用手机号验证码登录</text>
      </view>
    </block>

    <!-- ② 首次绑定手机号（已取到登录标识；2026-10-29 起短信退役，手机号用快捷验证组件） -->
    <block wx:elif="{{mode === 'bind'}}">
      <view class="mode-tip">首次登录，请验证手机号完成绑定</view>
      <button class="wechat-login-btn" open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber" disabled="{{submitting}}">
        {{submitting ? '绑定中…' : '手机号快捷验证'}}
      </button>
      <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
      <!-- 短信仍启用时才显示兼容绑定面板；SMS_ENABLED=false 时整块隐藏，不给假入口 -->
      <block wx:if="{{smsEnabled}}">
        <view class="mode-tip">或使用短信验证码绑定</view>
        <view class="input-row">
          <image class="input-icon" src="/icons/ui/phone.png" mode="aspectFit" />
          <input class="input-field" type="number" maxlength="11" placeholder="家长手机号（到店建档）"
            value="{{phone}}" bindinput="onPhoneInput" />
        </view>
        <view class="sms-row">
          <view class="input-row grow">
            <image class="input-icon" src="/icons/ui/key.png" mode="aspectFit" />
            <input class="input-field" type="number" maxlength="6" placeholder="短信验证码"
              value="{{code}}" bindinput="onCodeInput" />
          </view>
          <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
            {{countdown > 0 ? countdown + 's' : '获取验证码'}}
          </view>
        </view>
        <button class="phone-login-btn" bindtap="onBind" disabled="{{submitting}}">
          {{submitting ? '绑定中…' : '绑定并登录'}}
        </button>
      </block>
      <view class="mode-tip" wx:else>手机号验证失败时，请联系馆员在后台处理。</view>
      <!-- 绑定面板也要能直接进演示（审核员手机号未建档时，不用先退回来再点） -->
      <button class="demo-login-btn" wx:if="{{demoEnabled}}" bindtap="onDemoLogin" disabled="{{submitting}}">
        体验一下（只读）
      </button>
      <view class="alt-row">
        <text class="alt-link" bindtap="switchToWechat">返回快捷登录</text>
      </view>
    </block>

    <!-- ③ 短信兜底登录 -->
    <block wx:else>
      <view class="input-row">
        <image class="input-icon" src="/icons/ui/phone.png" mode="aspectFit" />
        <input class="input-field" type="number" maxlength="11" placeholder="家长手机号（到店建档）"
          value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="sms-row">
        <view class="input-row grow">
          <image class="input-icon" src="/icons/ui/key.png" mode="aspectFit" />
          <input class="input-field" type="number" maxlength="6" placeholder="短信验证码"
            value="{{code}}" bindinput="onCodeInput" />
        </view>
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
      <button class="phone-login-btn" bindtap="onSmsLogin" disabled="{{submitting}}">
        {{submitting ? '登录中…' : '登录'}}
      </button>
      <view class="alt-row">
        <text class="alt-link" bindtap="switchToWechat">用快捷登录</text>
      </view>
    </block>

    <!-- 拒绝隐私 / 取消授权后的固定出路（2026-11-12 审核驳回「点击取消/返回无效」）：
         必须给用户可执行的三个选择，而不是停在原地反复弹同一个弹窗。
         注意：位置固定在 if/elif/else 链**之后**：WXML 的 `wx:else` 只能紧跟 `wx:elif`，
         中间插任何节点都会让 else 分支脱离条件判断（短信表单会在微信模式下一起渲染，
         2026-11-14 开发者工具截图实测到；检查器不查结构，只能靠这条约定）。 -->
    <view class="privacy-blocked" wx:if="{{privacyBlocked}}">
      <view class="privacy-blocked-text">需要同意《隐私政策》后才能继续手机号验证</view>
      <view class="privacy-actions">
        <button class="privacy-btn primary" bindtap="retryAuthorize">重新同意并继续</button>
        <button class="privacy-btn" wx:if="{{demoEnabled}}" bindtap="onDemoLogin" disabled="{{submitting}}">体验一下（只读）</button>
        <button class="privacy-btn ghost" bindtap="exitMiniProgram">退出小程序</button>
      </view>
    </view>

    <!-- 隐私同意（2026-11-22 审核驳回「默认强制同意」）：改为**用户主动勾选**的复选框。
         旧文案「登录即代表同意…」本身就是被驳回的表述，已删除；
         复选框默认不勾选（login.js 的 agreed 初值 false），未勾选时登录入口只提示、不发请求。
         协议链接用 catchtap：点链接只跳转，不改变勾选状态。 -->
    <view class="agreement-row" bindtap="toggleAgreed">
      <view class="agree-check {{agreed ? 'agree-check-on' : ''}}">{{agreed ? '✓' : ''}}</view>
      <view class="agree-text">
        我已阅读并同意
        <text class="agreement-link" catchtap="goServiceAgreement">《用户服务协议》</text>
        与
        <text class="agreement-link" catchtap="goPrivacy">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
