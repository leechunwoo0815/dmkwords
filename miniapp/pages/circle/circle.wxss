/* pages/circle/circle.wxss — 阅读圈信息流（WM15-R1 朋友圈式布局，绘本风令牌） */
.page {
  background: var(--bg);
}

/* 顶部晒成就入口 */
.share-entry {
  margin: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-hard);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.share-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.share-entry-icon {
  font-size: 56rpx;
}
.share-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}
.share-entry-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--fg-muted, #8a7d72);
}
.share-entry-arrow {
  font-size: 44rpx;
  color: var(--fg-muted, #8a7d72);
}

/* 社区横幅（WM14-B） */
.banner {
  margin: 24rpx 24rpx 0;
  padding: 22rpx 28rpx;
  background: var(--accent, #fcd34d);
  border: 3rpx solid var(--fg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-hard);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.banner-emoji { font-size: 40rpx; }
.banner-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.4;
}

/* ===== WM15-R1 信息流：帖子之间用淡灰分隔线（朋友圈观感）===== */
.feed {
  padding: 0 24rpx;
}
.post {
  position: relative;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(90, 74, 58, 0.14);
}
.post:last-child { border-bottom: none; }

/* 置顶/馆长赞态 */
.post.pinned {
  margin: 16rpx -12rpx;
  padding: 24rpx 12rpx 28rpx;
  background: rgba(255, 253, 247, 0.86);
  border-radius: 22rpx;
  border-bottom: 1rpx solid rgba(90, 74, 58, 0.14);
}
.pin-badge {
  position: absolute;
  top: 10rpx;
  right: 0;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #3b2f2f;
  background: #fcd34d;
  border: 2rpx solid var(--fg);
  border-radius: 999rpx;
}

/* 头部：头像 + 名字 + 时间 */
.post-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.head-main {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.child-name {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 800;
  color: var(--fg);
}
.admin-mark { font-size: 26rpx; }
.meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--fg-muted, #8a7d72);
}
.del {
  font-size: 24rpx;
  color: #d0555f;
  padding: 8rpx 12rpx;
}

/* 成就文字（原生渲染，缩放不受图片影响） */
.post-body { margin-top: 16rpx; }
.ach-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 800;
  color: var(--fg);
  line-height: 1.35;
}
.ach-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #7a6650;
  line-height: 1.4;
}

/* 缩略配图：约 60% 宽、圆角；点开看含字完整大图 */
.thumb-wrap {
  margin-top: 18rpx;
  width: 60%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fffdf7;
}
.post-thumb {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  border: 2rpx solid rgba(90, 74, 58, 0.18);
  background: #fffdf7;
}
/* fix34e 羡慕杀②：馆长赞过 → 金色描边 + 外发光 + 一道循环流光（只动 transform，GPU 友好） */
.thumb-gold {
  border: 4rpx solid #f0b54a;
  box-shadow: 0 0 20rpx rgba(255, 192, 64, 0.7);
}
.thumb-gold .post-thumb {
  border-color: transparent;
}
.thumb-shine {
  position: absolute;
  top: -50%;
  bottom: -50%;
  width: 38%;
  background: linear-gradient(
    100deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.85) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  animation: shineSweep 2.8s linear infinite;
  pointer-events: none;
}
@keyframes shineSweep {
  0% { transform: translateX(-180%) rotate(10deg); }
  55%, 100% { transform: translateX(430%) rotate(10deg); }
}

/* 点赞 + 头像墙 */
.post-foot {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.like-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 22rpx;
  border: 2rpx solid rgba(90, 74, 58, 0.25);
  border-radius: 999rpx;
  background: var(--surface);
}
.like-btn.liked { border-color: #ef7a86; background: #fff0f3; }
.like-icon { font-size: 30rpx; }
.like-count { font-size: 26rpx; font-weight: 700; color: var(--fg); }

/* 点赞弹跳动效（交互完美感：低成本高感知） */
.like-btn.pop { animation: likePop 0.32s ease-out; }
@keyframes likePop {
  0% { transform: scale(1); }
  45% { transform: scale(1.18); }
  100% { transform: scale(1); }
}
.admin-liked .post-thumb { border-color: #e8a93b; }

.liker-wall {
  display: flex;
  align-items: center;
  gap: -10rpx;
}
/* fix34 R4：点赞头像墙改用 avatar-ring 组件（等级头像框）——负外边距做叠压 */
.liker-slot {
  margin-left: -10rpx;
  line-height: 0;
}
.liker-slot:first-child {
  margin-left: 0;
}
/* fix34d：馆长条——单独站位（不与孩子叠压）+ 金色光晕 + 呼吸式微缩放（"闪闪"的 GM 感）
   只动 transform（GPU 友好），不做高频 filter 动画（低端机代价高） */
.liker-slot-gm {
  margin-left: 0;
  margin-right: 6rpx;
  filter: drop-shadow(0 0 8rpx rgba(255, 209, 102, 0.85));
  transform-origin: center 60%;
  animation: gmBreath 2.4s ease-in-out infinite;
}
@keyframes gmBreath {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}
.admin-like-label {
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #c98a1c;
}
.liker-more {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--fg-muted, #8a7d72);
}

/* 状态块 */
.loading-wrap {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--fg-muted, #8a7d72);
}
.list-end {
  padding: 36rpx 0 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--fg-muted, #8a7d72);
}
.empty-state {
  padding: 120rpx 60rpx;
  text-align: center;
}
.empty-icon { font-size: 96rpx; }
.empty-text {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: var(--fg-muted, #8a7d72);
  line-height: 1.5;
}

/* fix34 R0：顶部「谁赞了你」通知条 + 展开列表（朋友圈式：未读出现，看完即消） */
.likes-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff2e6, #ffe8f0);
  border: 2rpx solid rgba(242, 147, 91, 0.35);
  box-shadow: 0 4rpx 14rpx rgba(242, 147, 91, 0.14);
}
.likes-bar.open {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}
.likes-bar-avatars {
  display: flex;
  align-items: center;
}
.likes-bar-slot {
  margin-left: -12rpx;
  line-height: 0;
}
.likes-bar-slot:first-child {
  margin-left: 0;
}
.likes-bar-text {
  flex: 1;
  font-size: 26rpx;
  color: #8a4d21;
  font-weight: 600;
}
.likes-bar-arrow {
  font-size: 24rpx;
  color: #b3743f;
}

.likes-panel {
  margin: 0 24rpx;
  padding: 8rpx 22rpx 4rpx;
  border-radius: 0 0 20rpx 20rpx;
  background: #fffdf9;
  border: 2rpx solid rgba(242, 147, 91, 0.35);
  border-top: none;
}
.likes-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(90, 74, 58, 0.08);
}
.likes-item:first-child {
  border-top: none;
}
.likes-item-body {
  flex: 1;
}
.likes-item-name {
  font-size: 28rpx;
  color: #4a3b2c;
  font-weight: 600;
}
.likes-item-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a8c80;
}
.likes-item-go {
  font-size: 24rpx;
  color: #f2935b;
}
.likes-panel-done {
  padding: 12rpx 0 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b9ada3;
}

/* fix34 R0b：已读态的低调条（小红点消失后仍可回看"谁赞了我"；一行灰字，不抢信息流视觉） */
.likes-quiet {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 30rpx 0;
  padding: 10rpx 4rpx;
}
.likes-quiet-text {
  font-size: 24rpx;
  color: #9a8c80;
}
.likes-quiet .likes-bar-arrow {
  font-size: 22rpx;
  color: #b3743f;
}
.likes-panel-empty {
  padding: 26rpx 0 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b9ada3;
}

/* fix34e 羡慕杀①：馆长亲赞金光播报（居中金卡 + 弹入动效 + 光晕） */
.gm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(46, 32, 12, 0.55);
}
.gm-card {
  position: relative;
  width: 580rpx;
  padding: 56rpx 44rpx 36rpx;
  border-radius: 40rpx;
  text-align: center;
  background: linear-gradient(160deg, #fff8de 0%, #ffe9a8 52%, #f7c552 100%);
  border: 4rpx solid #b87a12;
  box-shadow: 0 24rpx 70rpx rgba(120, 70, 10, 0.5);
  animation: gmPop 0.44s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}
@keyframes gmPop {
  from { transform: scale(0.55); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.gm-glow {
  position: absolute;
  left: 50%;
  top: 70rpx;
  width: 420rpx;
  height: 420rpx;
  margin-left: -210rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(255, 240, 180, 0) 70%);
  animation: gmGlow 2.6s ease-in-out infinite;
}
@keyframes gmGlow {
  0%, 100% { opacity: 0.65; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1.06); }
}
.gm-avatar {
  position: relative;
  line-height: 0;
}
.gm-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #8a4d21;
  letter-spacing: 2rpx;
}
.gm-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #a0662c;
}
.gm-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bb8b4a;
}
.gm-btn {
  margin-top: 30rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff8de;
  background: linear-gradient(135deg, #d99a24, #b87a12);
  box-shadow: 0 8rpx 20rpx rgba(184, 122, 18, 0.45);
}

/* fix34e3：馆长亲赞条目右侧标记（无"看名片"去处，改为金色徽标） */
.likes-item-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #8a4d21;
  background: linear-gradient(135deg, #fff2c4, #ffd166);
  border: 2rpx solid rgba(184, 122, 18, 0.5);
}
