/* pages/circle/profile.wxss — 孩子名片页（WM15-R4） */
.page { background: var(--bg); min-height: 100vh; padding: 24rpx 24rpx 80rpx; }

.card {
  position: relative;
  padding: 40rpx 32rpx 32rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx;
  box-shadow: var(--shadow-hard);
  text-align: center;
}
.history-tag {
  position: absolute; top: 20rpx; right: 24rpx;
  padding: 6rpx 18rpx; font-size: 22rpx; font-weight: 700;
  color: #6b5b5b; background: #efe7dc;
  border: 2rpx solid var(--fg); border-radius: 999rpx;
}
.big-avatar {
  width: 168rpx; height: 168rpx; border-radius: 50%;
  background: #fff; border: 3rpx solid rgba(90, 74, 58, 0.18);
}
.name {
  margin-top: 20rpx;
  font-family: var(--font-display); font-size: 44rpx; font-weight: 800; color: var(--fg);
}
.level-chip {
  display: inline-block; margin-top: 12rpx; padding: 6rpx 24rpx;
  font-size: 26rpx; font-weight: 700; color: #fff;
  background: #f2935b; border-radius: 999rpx;
}
.stats { display: flex; margin-top: 32rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num {
  font-family: var(--font-display); font-size: 40rpx; font-weight: 800; color: var(--fg);
}
.stat-lab { margin-top: 6rpx; font-size: 24rpx; color: var(--fg-muted, #8a7d72); }
.share-btn {
  margin-top: 32rpx; padding: 22rpx 0;
  font-size: 30rpx; font-weight: 800; color: #fff;
  background: #f2935b; border: 3rpx solid var(--fg); border-radius: 999rpx;
  box-shadow: var(--shadow-hard);
}

.section { margin-top: 36rpx; }
.section-title {
  font-family: var(--font-display); font-size: 32rpx; font-weight: 800; color: var(--fg);
  margin-bottom: 18rpx;
}
.badge-wall { display: flex; flex-wrap: wrap; gap: 18rpx; }
.badge {
  width: 140rpx; display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx; background: var(--surface);
  border: 2rpx solid rgba(90, 74, 58, 0.18); border-radius: 20rpx;
}
.badge-icon { width: 88rpx; height: 88rpx; }
.badge-lab {
  margin-top: 8rpx; font-size: 20rpx; color: var(--fg-muted, #8a7d72);
  text-align: center; line-height: 1.3;
}

.mini-feed { display: flex; flex-direction: column; gap: 18rpx; }
.mini-post {
  display: flex; gap: 16rpx; align-items: flex-start;
  padding: 20rpx; background: var(--surface);
  border: 2rpx solid rgba(90, 74, 58, 0.18); border-radius: 20rpx;
}
.mini-text { flex: 1; min-width: 0; }
.mini-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--fg); }
.mini-sub { display: block; margin-top: 6rpx; font-size: 24rpx; color: #7a6650; }
.mini-thumb { width: 140rpx; border-radius: 14rpx; border: 2rpx solid rgba(90, 74, 58, 0.14); }

.empty-hint {
  padding: 30rpx 0; font-size: 26rpx; color: var(--fg-muted, #8a7d72);
}
.loading-wrap {
  padding: 120rpx 0; text-align: center; font-size: 26rpx; color: var(--fg-muted, #8a7d72);
}

/* fix34 R6 生日彩蛋横幅（当天才渲染；彩带渐变 + 轻描边，与卡片暖色系一致） */
.birthday-bar {
  margin: 0 0 16rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #a34a1a;
  background: linear-gradient(135deg, #fff1c9, #ffe0e8);
  border: 2rpx solid rgba(242, 147, 91, 0.4);
}
