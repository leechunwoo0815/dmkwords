<view class="page" style="min-height:100vh;padding-bottom:120rpx;">
  <!-- 顶部晒成就入口（常驻） -->
  <view class="share-entry" bindtap="goShare">
    <view class="share-entry-left">
      <text class="share-entry-icon">🌟</text>
      <view>
        <view class="share-entry-title">晒成就</view>
        <view class="share-entry-sub">把孩子的高光时刻分享到馆内阅读圈</view>
      </view>
    </view>
    <text class="share-entry-arrow">›</text>
  </view>

  <!-- fix34 R0/R0b：朋友圈式「收到的赞」
       未读 → 高亮条（头像堆叠 + 文案，看完红点即消）；已读 → 低调条（永远可回看，不再"看完就找不着"） -->
  <view wx:if="{{unreadLikes > 0}}" class="likes-bar {{likesOpen ? 'open' : ''}}"
    bindtap="onOpenLikes">
    <view class="likes-bar-avatars">
      <view wx:for="{{likesUnread}}" wx:key="id" class="likes-bar-slot">
        <avatar-ring src="{{item.avatarUrl}}" level="{{item.level}}" size="{{48}}" />
      </view>
    </view>
    <text class="likes-bar-text">{{likesText}}</text>
    <text class="likes-bar-arrow">{{likesOpen ? '︿' : '﹀'}}</text>
  </view>
  <view wx:elif="{{likes.length}}" class="likes-quiet {{likesOpen ? 'open' : ''}}"
    bindtap="onOpenLikes">
    <text class="likes-quiet-text">{{likesQuietText}}</text>
    <text class="likes-bar-arrow">{{likesOpen ? '︿' : '查看 ﹀'}}</text>
  </view>

  <view wx:if="{{likesOpen}}" class="likes-panel">
    <view wx:if="{{!likes.length}}" class="likes-panel-empty">还没有人给你点赞，晒张成就卡试试～</view>
    <view wx:for="{{likes}}" wx:key="id" class="likes-item"
      data-child="{{item.childId}}" bindtap="onLikeItem">
      <avatar-ring src="{{item.avatarUrl}}" level="{{item.level}}" size="{{56}}" />
      <view class="likes-item-body">
        <view class="likes-item-name">{{item.name}} 赞了你的成就</view>
        <view class="likes-item-time">{{item.relTime}}</view>
      </view>
      <text class="likes-item-go">看名片 ›</text>
    </view>
    <view wx:if="{{likes.length}}" class="likes-panel-done">
      {{unreadLikes > 0 ? '看完了，红点会一起消失 ✓' : '已看过的赞都在这里，随时回看'}}
    </view>
  </view>

  <!-- 社区横幅（WM14-B）：本周全馆共读 -->
  <view wx:if="{{bannerWordsText}}" class="banner">
    <text class="banner-emoji">🌏</text>
    <text class="banner-text">本周全馆共读 {{bannerWordsText}} 词 · {{bannerKids}} 位小朋友在坚持</text>
  </view>

  <view wx:if="{{loading && !posts.length && !loadError}}" class="loading-wrap">加载中…</view>

  <error-view wx:if="{{loadError}}" type="network" title="加载失败"
    desc="阅读圈加载失败，请重试" bind:onRetry="onRetryLoad" />

  <block wx:if="{{!loading && !loadError && !posts.length}}">
    <view class="empty-state">
      <view class="empty-icon">📖</view>
      <view class="empty-text">还没有小伙伴晒成就——读完一本书，来做第一个！</view>
    </view>
  </block>

  <!-- WM15-R1 朋友圈式信息流：头像+名字+时间 / 成就文字原生 / 缩略图 / 点赞头像墙 / 分隔线 -->
  <view class="feed">
    <view wx:for="{{posts}}" wx:key="id" class="post {{item.admin_liked ? 'admin-liked' : ''}} {{item.is_pinned ? 'pinned' : ''}}">
      <view wx:if="{{item.is_pinned}}" class="pin-badge">馆方推荐</view>

      <!-- 头部：点头像/名字 → 名片页 -->
      <view class="post-head" bindtap="onChildProfile"
        data-child="{{item.child_id}}" data-name="{{item.child_name}}">
        <avatar-ring src="{{item.avatarUrl}}" level="{{item.level}}" size="{{84}}" />
        <view class="head-main">
          <view class="name-row">
            <text class="child-name">{{item.child_name}}</text>
            <text wx:if="{{item.admin_liked}}" class="admin-mark">🌟</text>
          </view>
          <text class="meta">{{item.parent_name}} · {{item.card_type_label}} · {{item.relTime}}</text>
        </view>
        <text wx:if="{{item.is_mine}}" class="del" data-id="{{item.id}}" catchtap="onDeletePost">删除</text>
      </view>

      <!-- 成就文字：原生渲染（card_data 快照；文字不再烧在图片里） -->
      <view class="post-body">
        <view class="ach-title">{{item.title}}</view>
        <view wx:if="{{item.subtitle}}" class="ach-sub">{{item.subtitle}}</view>
        <image wx:if="{{item.thumbUrl}}" class="post-thumb" src="{{item.thumbUrl}}" mode="widthFix"
          data-url="{{item.imageUrlFull}}" bindtap="onPreviewCard" />
      </view>

      <!-- 点赞 + 谁赞过（头像墙） -->
      <view class="post-foot">
        <view class="like-btn {{item.liked_by_me ? 'liked' : ''}} {{item.pop ? 'pop' : ''}}"
          data-id="{{item.id}}" bindtap="onToggleLike">
          <text class="like-icon">{{item.liked_by_me ? '❤️' : '🤍'}}</text>
          <text class="like-count">{{item.like_count}}</text>
        </view>
        <view wx:if="{{item.likers.length}}" class="liker-wall">
          <view wx:for="{{item.likers}}" wx:for-item="lk" wx:key="child_id" class="liker-slot">
            <avatar-ring src="{{lk.avatarUrl}}" level="{{lk.level}}" size="{{46}}" />
          </view>
          <text wx:if="{{item.like_count > item.likers.length}}" class="liker-more">+{{item.like_count - item.likers.length}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && posts.length && finished}}" class="list-end">— 到底啦，去读书吧 —</view>
  <view wx:if="{{loading && posts.length}}" class="loading-wrap">加载中…</view>
</view>
