<view class="page">
  <!-- 晒卡成功态：展示生成的成就卡片 -->
  <block wx:if="{{sharedPost}}">
    <view class="success-wrap">
      <view class="success-title"><image class="success-icon" src="/icons/ui/party.png" mode="aspectFit" /> 晒出去啦！</view>
      <view class="success-sub">长按卡片可保存，转发现实朋友圈让更多人看到</view>
      <image class="success-card" src="{{sharedPost.image_url}}" mode="widthFix"
        bindtap="onPreviewShared" />
      <view class="success-btns">
        <view class="btn-secondary" bindtap="onKeepSharing">继续晒</view>
        <view class="btn-primary" bindtap="goCircle">去阅读圈看看</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="child-bar">
      <image class="child-emoji" src="/icons/ui/child.png" mode="aspectFit" />
      <text class="child-name">{{childName}} 的成就</text>
    </view>

    <view class="tabs">
      <view class="tab {{tab === 'available' ? 'active' : ''}}" data-tab="available"
        bindtap="onTab">可晒（{{available.length}}）</view>
      <view class="tab {{tab === 'shared' ? 'active' : ''}}" data-tab="shared"
        bindtap="onTab">已晒（{{shared.length}}）</view>
    </view>

    <loading-skeleton wx:if="{{loading}}" type="rows" rows="{{4}}" />

    <block wx:if="{{!loading && tab === 'available'}}">
      <empty-state wx:if="{{!available.length}}" icon-name="sparkle"
        title="还没有可晒的新成就" desc="读完一本书、测个满分，回来第一个晒！" />
      <view class="card-list">
        <view wx:for="{{available}}" wx:key="index" class="ach-card"
          data-card="{{item}}" bindtap="onShareCard">
          <text class="ach-label">{{item.label}}</text>
          <view class="ach-title">{{item.title}}</view>
          <view class="ach-action">{{sharing ? '分享中…' : '晒成就 ›'}}</view>
        </view>
      </view>
    </block>

    <block wx:if="{{!loading && tab === 'shared'}}">
      <empty-state wx:if="{{!shared.length}}"
        icon-name="sparkle" title="还没有晒过的成就" desc="在阅读护照或测验结果页选一张卡片晒出来" />
      <view class="card-list">
        <view wx:for="{{shared}}" wx:key="index" class="ach-card shared">
          <text class="ach-label">{{item.label}}</text>
          <view class="ach-title">{{item.title}}</view>
          <view class="ach-action shared-action">已晒 ✓</view>
        </view>
      </view>
    </block>
  </block>
</view>
