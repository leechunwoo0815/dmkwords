/* pages/books/books.wxss — 图书馆 v5：搜索 + 筛选 + 2 列书卡 + 真分页 */
.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  /* 底部留白 ≥ 自定义 tabBar(100rpx)+安全区：防"到底啦"提示被 tabBar 遮挡 */
  padding: 20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
}

/* ---------- 搜索 ---------- */
.nav-bar { margin-bottom: 16rpx; }
.search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  padding: 16rpx 28rpx;
}
.search-icon { font-size: 30rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--fg); }
.search-clear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 2rpx solid var(--border);
  color: var(--muted);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 筛选行 ---------- */
.filter-bar {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.filter-bar picker { flex-shrink: 0; }
.filter-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--fg);
  font-weight: 600;
}
.filter-on {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}
.caret { font-size: 20rpx; opacity: 0.6; }

/* ---------- 已选 chips ---------- */
.chips-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.chip-x {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--accent);
  color: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.chip-x-btn { font-size: 20rpx; opacity: 0.85; }
.chip-clear {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 3rpx dashed var(--border);
  color: var(--muted);
  font-size: 22rpx;
}

.count-row { font-size: 24rpx; color: var(--muted); margin-bottom: 16rpx; }

/* ---------- 2 列书卡 ---------- */
.book-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.book-card {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  overflow: hidden;
}
.card-cover { position: relative; }
.card-cover-img {
  width: 100%;
  height: 340rpx;
  display: block;
  background: var(--accent-soft);
}
.card-cover-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 340rpx;
  font-size: 80rpx;
  background: var(--accent-soft);
}
.audio-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid var(--fg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.card-body { padding: 16rpx 20rpx 20rpx; }
/* 2026-09-15：原先 nowrap 单行截断，两列宫格里书名只能显示半截
   （「Harry Potter and the …」「The Very Hungry Cate…」还断在单词中间）。
   改两行截断 + 固定两行高，单行标题的卡也不会比双行标题的卡矮、宫格底边对齐。 */
.card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.32;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 69rpx;
}
.card-author {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tags { display: flex; gap: 8rpx; margin-top: 12rpx; flex-wrap: wrap; }
.tag {
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}
.tag-words { background: var(--secondary-soft); color: var(--success); }
.tag-ar { background: var(--accent-soft); color: var(--accent); }

.search-icon { width: 32rpx; height: 32rpx; }
.pill-icon { width: 26rpx; height: 26rpx; margin-right: 6rpx; vertical-align: -3rpx; }
.cover-ph { width: 96rpx; height: 96rpx; }
.audio-badge { width: 30rpx; height: 30rpx; }
