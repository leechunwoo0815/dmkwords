/* pages/books/books.wxss — 图书馆 v5：搜索 + 筛选 + 2 列书卡 + 真分页 */
.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  padding: 20rpx 24rpx 60rpx;
}

/* ---------- 搜索 ---------- */
.nav-bar { margin-bottom: 16rpx; }
.search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  padding: 16rpx 28rpx;
}
.search-icon { font-size: 30rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--fg); }
.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 2rpx solid var(--border);
  color: var(--muted);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 筛选行 ---------- */
.filter-bar {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.filter-bar picker { flex-shrink: 0; }
.filter-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--fg);
  font-weight: 600;
}
.filter-on {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent);
}
.caret { font-size: 20rpx; opacity: 0.6; }

/* ---------- 已选 chips ---------- */
.chips-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.chip-x {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--accent);
  color: #fff;
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.chip-x-btn { font-size: 20rpx; opacity: 0.85; }
.chip-clear {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 3rpx dashed var(--border);
  color: var(--muted);
  font-size: 22rpx;
}

.count-row { font-size: 24rpx; color: var(--muted); margin-bottom: 16rpx; }

/* ---------- 2 列书卡 ---------- */
.book-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.book-card {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  overflow: hidden;
}
.card-cover { position: relative; }
.card-cover-img {
  width: 100%;
  height: 340rpx;
  display: block;
  background: var(--accent-soft);
}
.card-cover-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 340rpx;
  font-size: 80rpx;
  background: var(--accent-soft);
}
.audio-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid var(--fg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.card-body { padding: 16rpx 20rpx 20rpx; }
.card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-author {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tags { display: flex; gap: 8rpx; margin-top: 12rpx; flex-wrap: wrap; }
.tag {
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}
.tag-words { background: rgba(74, 222, 128, 0.14); color: var(--success); }
.tag-ar { background: var(--accent-soft); color: var(--accent); }

.no-more {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  padding: 32rpx 0;
}
