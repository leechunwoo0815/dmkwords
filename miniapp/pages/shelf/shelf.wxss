/* pages/shelf/shelf.wxss — 书架 v5：真实资产页（在借/收藏/预约） */
.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  padding: 20rpx 24rpx 60rpx;
}

/* ---------- Tab 头 ---------- */
/* 2026-09-15：加了第 4 个页签「已通过」后，内容宽 4×200+3×16=848rpx > 可用 686rpx
   → 最后一个会被切掉（与 messages 分类条同族）。改等分自适应，4 个都完整可见。 */
.tab-head {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  flex: 1;
  justify-content: center;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 999rpx;
  padding: 14rpx 8rpx;
  font-size: 28rpx;
  color: var(--muted);
  font-weight: 600;
}
.tab-on {
  background: var(--accent);
  border-color: var(--fg);
  color: var(--surface);
  box-shadow: var(--shadow-hard-sm);
}
.tab-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--sun);
  color: var(--fg);
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}
.tab-on .tab-badge { background: var(--surface); color: var(--accent); }

/* ---------- 资产卡 ---------- */
.asset-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.asset-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--fg);
  flex-shrink: 0;
  background: var(--accent-soft);
}
.asset-cover-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.asset-info { flex: 1; min-width: 0; }
/* 2026-09-15：原 nowrap 单行截断 → 「Harry Potter and the Sorce…」；
   改两行截断，配合下面收窄的按钮列，书名可以完整显示 */
.asset-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.32;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.asset-meta { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.due-pill {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sky-soft);
  color: var(--sky);
  font-weight: 700;
}
.due-ok { background: var(--success-soft); color: var(--success); }
.due-over { background: var(--error-soft); color: var(--error); }
.asset-tags { display: flex; gap: 8rpx; margin-top: 10rpx; }
.tag { font-size: 18rpx; padding: 2rpx 14rpx; border-radius: 999rpx; font-weight: 700; }
.tag-words { background: var(--success-soft); color: var(--success); }
.tag-ar { background: var(--accent-soft); color: var(--accent); }

/* ---------- 操作按钮 ---------- */
/* 2026-09-15：原先 10/24rpx 内边距 + 3rpx 边 + 700 字重，按钮列宽到 ~166rpx，
   视觉重量压过书名（用户：按钮过大/过长）。收窄到 ~88rpx 宽，
   省下的横向空间留给书名放两行。 */
.asset-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}
.btn-mini {
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  background: var(--surface);
  color: var(--fg);
}
.btn-main {
  background: var(--accent);
  border-color: var(--fg);
  color: var(--surface);
  box-shadow: var(--shadow-hard-sm);
}

.empty-btn {
  margin: 24rpx auto 0;
  display: inline-block;
  background: var(--accent);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  color: var(--surface);
  font-size: 26rpx;
  font-weight: 700;
  padding: 14rpx 48rpx;
}
.loading-tip { text-align: center; color: var(--muted); font-size: 24rpx; padding: 40rpx 0; }

/* T43（U2）：passed 金色 🏆 角标 */
.asset-cover-wrap {
  position: relative;
}
.trophy-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 28rpx;
  background: var(--gold);
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(var(--fg-rgb), 0.25);
}
