/* pages/shelf/shelf.wxss — 书架 v5：真实资产页（在借/收藏/预约） */
.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  padding: 20rpx 24rpx 60rpx;
}

/* ---------- Tab 头 ---------- */
.tab-head {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tab-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 999rpx;
  padding: 14rpx 32rpx;
  font-size: 28rpx;
  color: var(--muted);
  font-weight: 600;
}
.tab-on {
  background: var(--accent);
  border-color: var(--fg);
  color: #fff;
  box-shadow: var(--shadow-hard-sm);
}
.tab-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--sun);
  color: var(--fg);
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}
.tab-on .tab-badge { background: #fff; color: var(--accent); }

/* ---------- 资产卡 ---------- */
.asset-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.asset-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--fg);
  flex-shrink: 0;
  background: var(--accent-soft);
}
.asset-cover-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.asset-info { flex: 1; min-width: 0; }
.asset-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.asset-meta { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.due-pill {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(96, 165, 250, 0.14);
  color: var(--sky);
  font-weight: 700;
}
.due-ok { background: rgba(74, 222, 128, 0.14); color: var(--success); }
.due-over { background: rgba(239, 68, 68, 0.12); color: var(--error); }
.asset-tags { display: flex; gap: 8rpx; margin-top: 10rpx; }
.tag { font-size: 18rpx; padding: 2rpx 14rpx; border-radius: 999rpx; font-weight: 700; }
.tag-words { background: rgba(74, 222, 128, 0.14); color: var(--success); }
.tag-ar { background: var(--accent-soft); color: var(--accent); }

/* ---------- 操作按钮 ---------- */
.asset-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}
.btn-mini {
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid var(--border);
  background: var(--surface);
  color: var(--fg);
}
.btn-main {
  background: var(--accent);
  border-color: var(--fg);
  color: #fff;
  box-shadow: var(--shadow-hard-sm);
}

.empty-btn {
  margin: 24rpx auto 0;
  display: inline-block;
  background: var(--accent);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 14rpx 48rpx;
}
.loading-tip { text-align: center; color: var(--muted); font-size: 24rpx; padding: 40rpx 0; }
