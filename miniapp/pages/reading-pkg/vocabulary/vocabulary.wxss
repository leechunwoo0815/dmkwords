/* pages/reading-pkg/vocabulary/vocabulary.wxss — 生词本（成就页，2026-09-21 重排）
   呈现口径：docs/15 §二十一 成就类页面呈现规范
   （成就头卡 + 四指标等高 + 书封锚点 + 三层信息 + 行内无删除按钮）。 */

.page-bg.vocab-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 成就头卡 ---------- */
.vocab-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent-hover));
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
  color: var(--surface);
}
.vh-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.vh-main {
  flex: 1;
  min-width: 0;
}
.vh-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 700;
}
.vh-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.92;
}
.vh-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
  flex-shrink: 0;
}
.vh-count-num {
  font-family: var(--font-display);
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--accent);
}
.vh-count-unit {
  font-size: 18rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* ---------- 四指标（等高一行） ---------- */
.vocab-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.vs-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 6rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 20rpx;
  box-shadow: var(--shadow-hard-sm);
}
.vs-val {
  font-family: var(--font-mono);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent-darker);
  line-height: 1.1;
}
.vs-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* ---------- 列表 ---------- */
.word-list {
  margin-top: 24rpx;
}
.word-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}
.word-item:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}
.wi-main {
  flex: 1;
  min-width: 0;
}
.wi-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
}
/* 第一层：主体（词最大最重、等宽字体、主色） */
.wi-word {
  font-family: var(--font-mono);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent-darker);
  line-height: 1.2;
}
/* 「查 N 次」= 积累感的来源，只给重复查过的词 */
.wi-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--sun);
  border: 2rpx solid var(--fg);
  color: var(--fg);
}
/* 第二层：属性（音标 mono / 释义正文） */
.wi-phonetic {
  display: block;
  font-family: var(--font-mono);
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.wi-def {
  display: block;
  font-size: 30rpx;
  color: var(--fg);
  line-height: 1.5;
  margin-top: 8rpx;
}
/* 第三层：出处（书名 + 日期，比主体淡一档，禁与主体同色同字号） */
.wi-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}
/* 出处用"书签小片"承载（不用封面图：列表里几十张网络图会拖慢渲染，用户裁定） */
.wi-src {
  font-size: 22rpx;
  color: var(--sky-ink);
  background: var(--sky-soft);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}
.wi-date {
  margin-left: auto; /* 日期靠右，书名自己截断，别让两个都在左边挤半行 */
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--muted-light);
}
.list-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  padding: 8rpx 0 16rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--muted);
}

/* ---------- 闪卡（点词看释义） ---------- */
.flashcard-overlay {
  position: fixed;
  box-sizing: border-box;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(var(--fg-rgb), 0.5);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  opacity: 0;
}
.flashcard-overlay.show {
  visibility: visible;
  opacity: 1;
}
.flashcard {
  width: 620rpx;
  max-height: 78vh;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 32rpx;
  padding: 44rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--shadow-hard);
  position: relative;
}
.fc-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg);
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.fc-close-icon {
  font-size: 28rpx;
  color: var(--muted);
}
/* 卡头：大词 + 音标（不放封面图，与列表同口径） */
.fc-top {
  display: flex;
  align-items: center;
  width: 100%;
  padding-right: 48rpx;
}
.fc-topmain {
  flex: 1;
  min-width: 0;
  text-align: left;
}
.flashcard .fc-word {
  display: block;
  font-family: var(--font-mono);
  font-size: 56rpx;
  font-weight: 700;
  color: var(--accent-darker);
  line-height: 1.15;
  word-break: break-all;
}
.flashcard .fc-phonetic {
  display: block;
  font-family: var(--font-mono);
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.fc-rule {
  width: 100%;
  height: 2rpx;
  background: var(--border);
  margin: 28rpx 0 24rpx;
}
/* 释义/出处左对齐：多行释义居中会参差（闪卡 = 字典卡，按阅读习惯排）。
   ⚠️ 必须配 align-self: stretch——.flashcard 是 align-items:center 的 flex 容器，
   子项会收缩到内容宽，光写 text-align:left 是**不生效的空话**（本轮目视抓到）。 */
.flashcard .fc-def {
  align-self: stretch;
  text-align: left;
  font-size: 38rpx;
  color: var(--fg);
  line-height: 1.5;
}
/* 英文释义：比中文轻一档，避免两段同权重打架 */
.flashcard .fc-def-en {
  align-self: stretch;
  text-align: left;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 14rpx;
  padding: 0 12rpx;
}
.fc-src-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  margin-top: 22rpx;
}
.flashcard .fc-hint {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 24rpx;
  color: var(--muted);
}
/* 「N月N日 收录」不许被折成两行（源书名换行可以，日期换行是排版事故） */
.fc-hint-date {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 24rpx;
  color: var(--muted-light);
}
.fc-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.fc-btn {
  padding: 20rpx 44rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.fc-btn.again {
  background: var(--warning-soft);
  border: 2rpx solid var(--fg);
  color: var(--fg);
}
.fc-btn.got {
  background: var(--surface);
  border: 2rpx solid var(--fg);
  color: var(--accent-darker);
}
