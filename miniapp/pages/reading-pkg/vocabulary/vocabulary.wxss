/* vocabulary.wxss — aligned with design/user-end/vocabulary.html */

/* Nav Bar */
.nav-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-bar .back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.nav-bar .back-arrow {
  font-size: 40rpx;
}

.nav-bar .title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
}

.nav-bar .nav-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}

.nav-bar .right-btn {
  margin-left: auto;
}

.nav-bar .right-btn .right-btn-text {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 500;
}

/* Page Hint（2026-09-15 补：原先 .vocab-hint 在 wxss 里**完全没有规则**，
   提示语零左内边距紧贴屏幕左缘、并折行成一个孤字「习」） */
.page-bg.vocab-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.vocab-hint {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 32rpx 32rpx 8rpx;
}

.vocab-hint .vh-title {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.3;
}

.vocab-hint .vh-sub {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.45;
}

/* Stats Row */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 32rpx;
}

.stats-row .st {
  flex: 1;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.st .st-val {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.st .st-label {
  font-size: 22rpx;
  color: var(--muted);
  display: block;
}

.st.learning .st-val {
  color: var(--accent);
}

.st.mastered .st-val {
  color: var(--success);
}

/* Tabs */
.tabs {
  display: flex;
  margin: 0 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  overflow: hidden;
}

.tab-btn {
  flex: 1;
  padding: 18rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  text-align: center;
}

.tab-btn.active {
  background: var(--accent);
  color: var(--surface);
}

/* Sort Bar */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}

.sort-bar .count {
  font-size: 24rpx;
  color: var(--muted);
}

.sort-bar .sort-select {
  font-size: 24rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  background: var(--surface);
  color: var(--fg);
}

/* Word List */
.word-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow-hard-sm);
}

.word-item:active {
  transform: scale(0.99);
}

.word-main {
  flex: 1;
  min-width: 0;
}

/* 生词是这张卡的主角：大字 + 强调色（2026-09-15 用户点名「分不清哪个是我查过的词」） */
.word-main .w-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.word-main .w-word {
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 700;
  color: var(--accent-dark);
  line-height: 1.2;
}

.word-main .w-phonetic {
  font-size: 24rpx;
  color: var(--muted);
  display: block;
  margin-top: 6rpx;
}

.word-main .w-def {
  font-size: 28rpx;
  color: var(--fg);
  margin-top: 8rpx;
  display: block;
  line-height: 1.45;
}

/* 来源书单独占一行、更小更淡 —— 不让书名和生词抢视觉、也不挤在同一行 */
.word-main .w-src {
  font-size: 22rpx;
  color: var(--muted);
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
  white-space: nowrap;
}

.word-tag.learning {
  background: var(--accent-soft);
  color: var(--accent);
}

.word-tag.mastered {
  background: var(--success-soft);
  color: var(--success);
}

.word-actions {
  display: flex;
  gap: 8rpx;
}

.word-actions .action-btn {
  /* 2026-09-15 修复：原 width:60rpx 是「图标」尺寸，但 wxml 里是文字「删除」
     → 两字撑出 60rpx 溢出卡片右缘。改按文字自适应。 */
  min-width: 60rpx;
  height: 60rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--muted);
}

.word-actions .action-btn .action-icon {
  font-size: 32rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--muted);
}

.empty-state .emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
}

.empty-state .text-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 24rpx;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--muted);
}

/* Flashcard Overlay */
.flashcard-overlay {
  position: fixed;
    box-sizing: border-box;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(var(--fg-rgb), 0.5);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  opacity: 0;
  box-sizing: border-box;
}

.flashcard-overlay.show {
  visibility: visible;
  opacity: 1;
}

.flashcard {
  width: 600rpx;
  height: 760rpx;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 24rpx;
  box-shadow: 0 32rpx 96rpx rgba(var(--fg-rgb), 0.15);
  position: relative;
}

.flashcard .fc-word {
  font-family: var(--font-display);
  font-size: 64rpx;
  font-weight: 700;
}

.flashcard .fc-phonetic {
  font-size: 32rpx;
  color: var(--muted);
}

.flashcard .fc-def {
  font-size: 36rpx;
  color: var(--fg);
}

/* 英文释义：比中文翻译轻一档，避免两段同权重打架 */
.flashcard .fc-def-en {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
  padding: 0 24rpx;
}

.flashcard .fc-hint {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 16rpx;
}

.fc-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.fc-btn {
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.fc-btn.again {
  background: var(--accent-soft);
  color: var(--accent);
}

.fc-btn.got {
  background: var(--success);
  color: var(--surface);
}

.fc-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(var(--fg-rgb), 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-close .fc-close-icon {
  font-size: 32rpx;
  color: var(--surface);
}

/* Review Progress Bar */
.review-progress-bar {
  position: absolute;
  top: 80rpx;
  left: 48rpx;
  right: 48rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 31;
}

.review-progress-track {
  flex: 1;
  height: 8rpx;
  background: rgba(var(--surface-rgb), 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.review-progress-fill {
  height: 100%;
  background: var(--surface);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.review-progress-text {
  font-size: 24rpx;
  color: rgba(var(--surface-rgb), 0.9);
  white-space: nowrap;
  font-weight: 600;
}

/* Review Complete Overlay */
.review-complete-overlay {
  position: fixed;
    box-sizing: border-box;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--success-soft), rgba(var(--success-rgb), 0.75));
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  opacity: 0;
  box-sizing: border-box;
}

.review-complete-overlay.show {
  visibility: visible;
  opacity: 1;
  animation: completeFadeIn 0.3s ease;
}

@keyframes completeFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.review-complete-card {
  width: 560rpx;
  background: var(--surface);
  border-radius: 32rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  box-shadow: 0 16rpx 64rpx rgba(var(--fg-rgb), 0.2);
  animation: completeScaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes completeScaleIn {
  0% {
    transform: scale(0.3);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.review-complete-emoji {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.review-complete-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--fg);
  display: block;
  margin-bottom: 12rpx;
}

.review-complete-desc {
  font-size: 28rpx;
  color: var(--muted);
  display: block;
  margin-bottom: 48rpx;
}

.review-complete-btn {
  width: 360rpx;
  margin: 0 auto;
  background: var(--success);
  color: var(--surface);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
}

/* 排序选择器 - 字体 */
.sort-bar .sort-select {
  font-family: var(--font-body);
}

/* 选项 active 态 */
.action-btn:active {
  background: var(--accent-soft);
  color: var(--accent);
}


/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */
/* 按钮：胶囊贴纸 */
.btn, button, .primary-btn, .secondary-btn, .action-btn {
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  font-weight: 700;
}
.btn-primary, .primary, button[type="primary"], .primary-btn {
  background: var(--accent);
  color: var(--surface);
}
.btn-secondary, .secondary, .secondary-btn {
  background: var(--surface);
  color: var(--fg);
}
.btn:active, button:active, .primary-btn:active, .secondary-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}

/* 标签/徽章：圆角贴纸 */
.tag, .badge, .pill, .tag-primary, .tag-secondary, .tag-success, .tag-warning {
  border: 2rpx solid rgba(var(--fg-rgb), 0.6);
  border-radius: 999rpx;
  font-weight: 700;
}
.tag-primary, .badge-primary { background: var(--accent-soft); color: var(--accent-dark); }
.tag-secondary, .badge-secondary { background: var(--secondary-soft); color: var(--secondary-ink); }
.tag-success, .badge-success { background: var(--success-soft); color: var(--success); }
.tag-warning, .badge-warning { background: var(--warning-soft); color: var(--warning-dark); }

.item, .row, .cell {
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: 3rpx 3rpx 0 rgba(var(--fg-rgb), 0.55);
}

/* 列表容器：加间距 */
.list, .grid, .list-container {
  gap: 16rpx;
}


/* ============================================
   2026-09-15 生词本改造收尾（必须放在上面的「绘本风精修覆盖块」之后才生效）
   ============================================ */
/* 删除是低频破坏性动作，必须比生词本身轻：上面覆盖块把 .action-btn 统一成了
   粗边+硬阴影+加粗的主按钮观感，导致「删除」成了整张卡最重的元素、喧宾夺主。 */
.word-actions .action-btn {
  border: 2rpx solid var(--border);
  box-shadow: none;
  font-weight: 500;
  background: var(--bg);
  color: var(--muted);
}

/* 统计卡与生词卡同款卡片语汇（原 2rpx 细边无阴影，比下方的卡「平」一档） */
.stats-row .st {
  border: 3rpx solid var(--border);
  border-radius: 24rpx 28rpx 20rpx 30rpx;
  box-shadow: var(--shadow-hard-sm);
}

/* 闪卡：原固定 760rpx 高 + 内容居中 → 上下各留一大片空（内容只占 58%）。
   改成由内容撑高 + 上下限，短词卡不再被拉成空盒子。 */
.flashcard {
  width: 600rpx;
  height: auto;
  min-height: 520rpx;
  max-height: 820rpx;
  padding: 64rpx 48rpx;
}

/* 「移出生词本」是破坏性动作，原先用 --success 绿＝「成功/达成」语义打反；
   改软红，并保留它是卡内次要动作的份量 */
.flashcard .fc-btn.got {
  background: var(--error-soft);
  color: var(--error);
}

/* 「知道了」才是这一屏的主操作：上面两个都成了软底浅字后主次不分，主按钮改实心 */
.flashcard .fc-btn.again {
  background: var(--accent);
  color: var(--surface);
}
