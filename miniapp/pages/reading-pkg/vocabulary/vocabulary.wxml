<!-- 生词本（WM8/FEAT-054）：成就页呈现规范见 docs/15 §二十一 -->
<view class="page-bg vocab-page">
  <!-- 成就头卡：先回答"我攒了多少" -->
  <view class="vocab-hero">
    <image class="vh-icon" src="/icons/ui/book.png" mode="aspectFit" />
    <view class="vh-main">
      <view class="vh-title">{{childName}} 的生词本</view>
      <view class="vh-sub">{{heroSub}}</view>
    </view>
    <view class="vh-count" wx:if="{{!loading && !loadError}}">
      <text class="vh-count-num">{{words.length}}</text>
      <text class="vh-count-unit">词</text>
    </view>
  </view>

  <view class="vocab-stats" wx:if="{{!loading && !loadError && words.length}}">
    <view class="vs-item">
      <text class="vs-val">{{totalLookups}}</text>
      <text class="vs-label">累计查词</text>
    </view>
    <view class="vs-item">
      <text class="vs-val">{{bookCount}}</text>
      <text class="vs-label">来源书目</text>
    </view>
    <view class="vs-item">
      <text class="vs-val">{{weekCount}}</text>
      <text class="vs-label">本周新增</text>
    </view>
    <view class="vs-item">
      <text class="vs-val">{{repeatCount}}</text>
      <text class="vs-label">查过多次</text>
    </view>
  </view>

  <view wx:if="{{loading && !loadError}}" class="loading">加载中…</view>

  <error-view wx:if="{{loadError}}" type="network" title="加载失败"
    desc="生词本加载失败，请重试" bind:onRetry="onRetryLoad" />

  <empty-state wx:if="{{!loading && !loadError && !words.length}}"
    icon-name="book" title="还没有生词" desc="播放页下半屏查词会自动收录" />

  <view class="word-list" wx:if="{{words.length}}">
    <view class="word-item" wx:for="{{words}}" wx:key="id" data-index="{{index}}"
      bindtap="onOpenCard" bindlongpress="onLongPress">
      <view class="wi-main">
        <view class="wi-head">
          <text class="wi-word">{{item.word}}</text>
          <text class="wi-tag" wx:if="{{item.lookup_count > 1}}">查 {{item.lookup_count}} 次</text>
        </view>
        <text class="wi-phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
        <text class="wi-def" wx:if="{{item.translation}}">{{item.translation}}</text>
        <view class="wi-foot">
          <text class="wi-src" wx:if="{{item.source_title}}">{{item.source_title}}</text>
          <text class="wi-date" wx:if="{{item.dateText}}">{{item.dateText}} 收录</text>
        </view>
      </view>
    </view>
    <view class="list-hint">长按词条可移出生词本 · 点词看闪卡释义</view>
  </view>

  <view class="flashcard-overlay {{cardWord ? 'show' : ''}}" bindtap="onCloseCard">
    <view class="flashcard" catchtap="noop">
      <view class="fc-close" catchtap="onCloseCard">
        <text class="fc-close-icon">✕</text>
      </view>
      <view class="fc-top">
        <view class="fc-topmain">
          <text class="fc-word">{{cardWord}}</text>
          <text class="fc-phonetic" wx:if="{{cardPhonetic}}">{{cardPhonetic}}</text>
        </view>
      </view>
      <view class="fc-rule"></view>
      <text class="fc-def" wx:if="{{cardTranslation}}">{{cardTranslation}}</text>
      <text class="fc-def-en" wx:if="{{cardDefinition}}">{{cardDefinition}}</text>
      <view class="fc-src-line" wx:if="{{cardSource}}">
        <text class="fc-hint">来自《{{cardSource}}》</text>
        <text class="fc-hint-date" wx:if="{{cardDate}}">{{cardDate}} 收录</text>
      </view>
      <view class="fc-actions">
        <view class="fc-btn again" catchtap="onCloseCard">知道了</view>
        <view class="fc-btn got" catchtap="onRemoveCard">移出生词本</view>
      </view>
    </view>
  </view>
</view>
