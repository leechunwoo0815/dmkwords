/* frontend/pages/reader/reader.wxss */
/* V3.1 音频伴读阅读器样式 — aligned with design prototype */

.reader-page {
  min-height: 100vh;
  background: var(--bg);
  font-size: 30rpx;
  line-height: 1.5;
  padding-bottom: 120rpx;
}

/* 图书信息 — capsule AR/value tags */
.book-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56rpx 32rpx 48rpx;
  gap: 24rpx;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  margin-bottom: 0;
}
.book-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
}
.book-title {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--fg);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.book-author {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}
.audio-slider {
  flex: 1;
  margin: 0 16rpx;
}
.audio-slider .progress-track {
  height: 12rpx;
  background: var(--border);
  border-radius: 6rpx;
}
.audio-slider .progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 6rpx;
}
.audio-slider .progress-handle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--accent);
  border: 5rpx solid var(--surface);
  box-shadow: 0 2rpx 8rpx rgba(var(--fg-rgb), 0.15);
}
.audio-btn-main.playing {
  box-shadow: 0 12rpx 64rpx rgba(var(--accent-rgb), 0.5);
}
.speed-item.active {
  background: var(--accent);
  color: var(--surface);
  border-color: var(--accent);
}

/* 无音频 */
.no-audio {
  background: var(--surface);
  padding: 80rpx 32rpx;
  text-align: center;
  margin-bottom: 0;
  border-bottom: 2rpx solid var(--border);
}
.no-audio-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.no-audio-text { font-size: 28rpx; color: var(--muted); }

/* 查词 */
.lookup-section {
  background: var(--surface);
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 0;
  border-bottom: 2rpx solid var(--border);
}
.lookup-btn {
  width: auto;
  height: auto;
  background: var(--accent);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surface);
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 36rpx;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes scaleIn { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }
@keyframes popStar { 0% { transform: scale(0) rotate(-30deg); } 60% { transform: scale(1.3) rotate(10deg); } 100% { transform: scale(1) rotate(0); } }

/* 完成弹窗 — 对齐 design/user-end/reader.html */
.completion-overlay {
  position: fixed; inset: 0; z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  background: rgba(var(--fg-rgb), 0.5);
  animation: fadeIn 0.3s ease;
  box-sizing: border-box;
}
.completion-card {
  background: var(--surface); border-radius: var(--radius-lg);
  padding: 72rpx 48rpx 56rpx;
  width: calc(100% - 80rpx); max-width: 680rpx;
  text-align: center; position: relative; overflow: hidden;
  box-shadow: 0 40rpx 120rpx rgba(var(--fg-rgb), 0.15);
  animation: scaleIn 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
.meta-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.meta-tag.ar { background: var(--accent-soft); color: var(--accent); }
.meta-tag.words { background: rgba(var(--success-rgb), 0.1); color: var(--success); }

/* ===== AUDIO PLAYER SECTION (design prototype) ===== */
.player-section {
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/* Progress area */
.progress-area {
  width: 100%;
  margin-bottom: 40rpx;
}
.progress-times {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  margin-bottom: 16rpx;
}
.progress-times .time-now { color: var(--fg); font-weight: 600; }

/* Playback controls */
.playback-controls {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 36rpx;
}
.ctrl-skip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-sm);
  transition: background 0.12s;
}
.ctrl-skip:active { background: var(--accent-soft); }
.ctrl-skip svg { width: 44rpx; height: 44rpx; color: var(--fg); }
.ctrl-skip .skip-label {
  font-size: 18rpx;
  color: var(--muted);
  font-weight: 700;
  letter-spacing: -0.02em;
}
.ctrl-play {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(var(--accent-rgb), 0.35);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.ctrl-play:active { transform: scale(0.92); }
.ctrl-play.playing {
  box-shadow: 0 8rpx 56rpx rgba(var(--accent-rgb), 0.5);
}
.ctrl-play svg { width: 52rpx; height: 52rpx; color: var(--surface); }

/* Speed selector */
.speed-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 40rpx;
}
.speed-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--bg);
  color: var(--muted);
  border: 2rpx solid var(--border);
  transition: all 0.15s ease;
}
.speed-chip:active { transform: scale(0.95); }
.speed-chip.active {
  background: var(--accent);
  color: var(--surface);
  border-color: var(--accent);
}
.dict-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.dict-input {
  flex: 1;
  padding: 20rpx 28rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  font-size: 28rpx;
  color: var(--fg);
  outline: none;
  transition: border-color 0.15s;
}
.dict-input::placeholder { color: var(--muted); }
.dict-input:focus { border-color: var(--accent); }
.dict-result {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
  display: none;
}
.dict-result.show { display: block; }
.dr-word {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 700;
}
.dr-phonetic {
  font-size: 26rpx;
  color: var(--muted);
  margin: 4rpx 0 16rpx;
}
.dr-def {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--fg);
  margin-bottom: 24rpx;
}
.overdue-overlay.show { display: flex; }

/* ===== COMPLETION POPUP (design prototype) ===== */
.completion-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(var(--fg-rgb), 0.5);
  display: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.completion-overlay.show { display: flex; }
.popup-emoji { font-size: 112rpx; margin-bottom: 12rpx; }
.popup-title {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.popup-sub {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 40rpx;
}
.popup-stats {
  display: flex;
  gap: 20rpx;
  margin-bottom: 44rpx;
  justify-content: center;
}
.popup-stat {
  flex: 1;
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 24rpx 12rpx;
  max-width: 192rpx;
}
.popup-stat .val {
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
}
.popup-stat .lbl {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.popup-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.popup-btn {
  padding: 26rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  transition: transform 0.12s;
}
.popup-btn:active { transform: scale(0.97); }
.popup-btn.primary {
  background: var(--accent);
  color: var(--surface);
  box-shadow: 0 8rpx 32rpx rgba(var(--accent-rgb), 0.3);
}
.popup-btn.secondary { background: var(--border); color: var(--muted); }
.simple-play-btn.playing {
  background: linear-gradient(135deg, var(--accent-light), var(--gold));
}

/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */

/* 封面：粗黑边贴纸 + 太阳黄书脊 */
.reader-page .book-cover {
  border: 3rpx solid var(--fg);
  border-radius: 16rpx 20rpx 14rpx 22rpx;
  box-shadow: var(--shadow-hard-sm);
  background: linear-gradient(160deg, var(--sun-soft), var(--surface));
}

/* 书名圆体 */
.reader-page .book-title {
  font-family: var(--font-display);
  font-weight: 800;
}
.audio-btn-main.playing {
  background: var(--success);
}
.speed-item.active {
  background: var(--sun);
  color: var(--fg);
  box-shadow: 2rpx 2rpx 0 rgba(var(--fg-rgb), 0.85);
}


/* 绘本风精修补充：查词按钮 */
.lookup-btn {
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  font-weight: 800;
}
.lookup-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}

/* ============================================
   听书页 v4 改造（2026-08-30）：进度条 + 查词可见性
   ============================================ */

.dict-result {
  display: block;
  margin: 24rpx 32rpx;
  padding: 28rpx 32rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 28rpx 32rpx 24rpx 36rpx;
  box-shadow: var(--shadow-hard-sm);
}

.dict-loading {
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
  padding: 20rpx 0;
}

.dr-word {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  color: var(--fg);
}

.dr-phonetic {
  font-size: 26rpx;
  color: var(--muted);
  margin: 8rpx 0 16rpx;
}

.dr-def {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--fg);
  margin-bottom: 12rpx;
}

.audio-slider {
  flex: 1;
}

.progress-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
}

.progress-times {
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 600;
  min-width: 60rpx;
  text-align: center;
}


