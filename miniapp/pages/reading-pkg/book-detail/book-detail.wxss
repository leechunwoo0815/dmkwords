/* frontend/pages/book-detail/book-detail.wxss */

.page-bg {
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.nav-bar .title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 600;
}

/* Hero cover (prototype alias) */
.hero-cover {
  width: 220rpx;
  height: 296rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent-soft), rgba(var(--accent-rgb), 0.12));
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* Hero info (prototype alias) */
.hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-title {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.hero-author {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.hero-tags .tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* Book hero */
.book-hero {
  display: flex;
  gap: 32rpx;
  padding: 40rpx 32rpx;
  background: var(--surface);
  margin-bottom: 20rpx;
}

.tag-ar {
  background: var(--accent-soft);
  color: var(--accent);
}

.tag-words {
  background: var(--accent-soft);
  color: var(--muted);
}

.tag-time {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(var(--success-rgb), 0.1);
  color: var(--success);
}
.tag-time-icon {
  width: 26rpx;
  height: 26rpx;
}

/* 插修8/U1+插修9/R8（FEAT-081）测验成就三态徽章：金=通过 / 蓝=再挑战 / 灰=锁定或机会用尽 */
.quiz-hero-card {
  margin: 0 32rpx 20rpx;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, var(--sun), var(--accent-light));
  color: var(--surface);
  box-shadow: 0 6rpx 18rpx rgba(var(--accent-light-rgb), 0.35);
}

/* 插修9/R8：英文印章主视觉——盖章的歪斜感是灵魂，别改垂直。
   用户直接指令（2026-09-05）：通过=绿色印章的心智符号，白底垫层把绿章
   从金橙渐变底上隔离出来，加大加粗更有视觉冲击 */
.qhc-stamp {
  display: inline-block;
  font-size: 80rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  color: var(--success);
  background: rgba(var(--surface-rgb), 0.94);
  border: 8rpx solid var(--success);
  border-radius: 20rpx;
  padding: 8rpx 36rpx;
  transform: rotate(-8deg);
  box-shadow: 0 6rpx 14rpx var(--success-soft);
}

.qhc-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold-dark);
}

.qhc-stars {
  margin-top: 10rpx;
  /* inline-flex：卡片是块级容器，块级 flex 会撑满整行，药丸要贴着内容
     （同 .qhc-stamp 的 inline-block 口径） */
  display: inline-flex;
  align-items: center;
  /* 2026-09-17：金星压在金橙渐变底上怎么调都发闷（用户复验「星星还是不明显，
     因为背景也是黄的」）。装白垫层隔离——与同卡 PASSED 印章同一手法
     （见下方 §插修9/R8 注释），不动「金卡」本身的配色语义（docs/03 FEAT-081）。
     垫层 85% 白 + 星色亮黄 #FFD84D：底色够白才撑得住亮黄星（实测亮度差 34、
     蓝通道差 149，形状靠墨线、底色靠色相）。 */
  background: rgba(var(--surface-rgb), 0.85);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.qhc-star {
  /* 2026-09-17：36rpx 比原来的 ⭐(font-size: 40rpx) 小一圈，用户复验「以前是大点的星星」→ 44rpx */
  width: 44rpx;
  height: 44rpx;
  margin-right: 4rpx;
}

.qhc-best {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-dark);
}

.qhc-cheer {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--gold-dark);
}

.qhc-tip {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--gold-dark);
  opacity: 0.85;
}

.quiz-challenge-card {
  margin: 0 32rpx 20rpx;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  background: var(--sky);
  color: var(--surface);
  box-shadow: 0 6rpx 18rpx rgba(var(--fg-rgb), 0.35);
}

.qcc-title {
  font-size: 32rpx;
  font-weight: 700;
}

.qcc-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.qcc-btn {
  margin-top: 16rpx;
  background: var(--surface);
  color: var(--sky-ink);
  border: 3rpx solid var(--sun);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 2.2;
}

.qcc-btn::after {
  border: none;
}

.pulse-anim {
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.04);
  }
}

.quiz-locked-hint {
  margin: 0 32rpx 20rpx;
  padding: 8rpx 4rpx;
  font-size: 28rpx;
  color: var(--muted);
}

/* Reading progress */
.reading-progress {
  margin: 0 32rpx 24rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
}

.reading-progress .rp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reading-progress .rp-title {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 600;
}

.reading-progress .rp-pct {
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
}

.rp-bar {
  height: 12rpx;
  background: var(--border);
  border-radius: 6rpx;
  overflow: hidden;
}

.rp-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 6rpx;
}

/* Section cards */
.section-card {
  margin: 0 32rpx 20rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(var(--fg-rgb), 0.04);
}

.section-card-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
}

.desc-text {
  font-size: 26rpx;
  color: var(--fg);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.desc-text.expanded {
  -webkit-line-clamp: unset;
}

/* Bottom action bar */
.action-bar {
  position: fixed;
    box-sizing: border-box;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(var(--surface-rgb), 0.95);
  border-top: 2rpx solid var(--border);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  z-index: 20;
  box-sizing: border-box;
}

.action-primary {
  flex: 1;
  background: var(--accent);
  color: var(--surface);
  box-shadow: 0 8rpx 32rpx rgba(var(--accent-rgb), 0.3);
}

/* ================================================================
   Standalone Progress Section (not wrapped in .reading-progress)
   ================================================================ */
.progress-section {
  margin: 0 32rpx 20rpx;
}

.progress-section .rp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-section .rp-title {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 600;
}

.progress-section .rp-pct {
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
}

.progress-section .rp-bar {
  height: 12rpx;
  background: var(--border);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-section .rp-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 6rpx;
}

/* ================================================================
   Tag color refinements
   ================================================================ */
.tag-time {
  background: rgba(var(--success-rgb), 0.1);
  color: var(--success);
}

.state-toggle button.active {
  background: var(--accent);
  color: var(--surface);
}


/* C49：详情页封面 */
.hero-cover {
  width: 160rpx;
  height: 216rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--ink, var(--accent));
  flex-shrink: 0;
  margin-right: 24rpx;
  background: var(--paper, var(--surface));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}

/* ============================================
   绘本风精修（v3 2026-08-30）— 覆盖块，勿删
   ============================================ */

/* 底部操作栏：粗黑顶边 + 按钮胶囊贴纸 */
.action-bar {
  border-top: 3rpx solid var(--fg);
}
.action-bar .action-primary {
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
  background: var(--accent);
  font-weight: 800;
}
.action-bar .action-primary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}
.action-bar .action-secondary {
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--fg);
  font-weight: 700;
}
.action-bar .action-fav {
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--fg);
}

.action-bar {
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 3rpx solid var(--fg);
}

.action-primary {
  width: 100%;
  height: 92rpx;
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--surface);
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: var(--shadow-hard-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-primary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: none;
}

.action-primary::after {
  border: none;
}

.action-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
}

.action-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: transparent;
  border: none;
  padding: 8rpx 12rpx;
  line-height: 1;
}

.action-icon::after {
  border: none;
}

.action-icon-emoji {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  border: 2rpx solid var(--fg);
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 2rpx 2rpx 0 rgba(var(--fg-rgb), 0.55);
}

.action-icon.active .action-icon-emoji {
  background: var(--sun-soft);
}

.action-icon-label {
  font-size: 22rpx;
  color: var(--fg);
  font-weight: 600;
}

.action-icon[disabled] {
  opacity: 0.6;
}

/* ---------- v5 增补：meta chips / 状态卡 / 简介 ---------- */
.hero-meta { display: flex; gap: 10rpx; margin-top: 12rpx; flex-wrap: wrap; }
.meta-chip {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sky-soft);
  color: var(--sky);
  font-weight: 600;
}
.meta-chip2 { background: var(--lavender-soft); color: var(--lavender); }

.state-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: var(--radius-sm);
  border: 3rpx solid var(--fg);
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-hard-sm);
}
.state-borrowing { background: var(--secondary-soft); }
.state-reserved { background: var(--sun-soft); }
.state-emoji { font-size: 44rpx; }
.state-texts { flex: 1; }
.state-title { font-size: 28rpx; font-weight: 700; color: var(--fg); }
.state-sub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.state-arrow { font-size: 40rpx; color: var(--muted); }

.muted-line { color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.desc-text { color: var(--fg); font-size: 26rpx; line-height: 1.7; }

.hero-cover-empty { justify-content: center; font-size: 72rpx; }

.hero-cover-empty { padding: 40rpx; }
.state-emoji { width: 72rpx; height: 72rpx; }
.action-icon-emoji { width: 36rpx; height: 36rpx; }
