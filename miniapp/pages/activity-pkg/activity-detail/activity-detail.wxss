/* pages/activity-pkg/activity-detail/activity-detail.wxss — 活动详情
   2026-09-13 按统一模板契约重做：删除不在 wxml 中的死规则（top-bar/faq/teacher/
   bring-box/toast 等，原 536 行 → 精简）；渐变/遮罩全部令牌化；
   修复两处遮挡：info-card 负 margin 上滑盖住「活动信息」标题、action-bar 压住内容。 */
.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  /* 底部留白 ≥ action-bar（约 170rpx）+ 安全区：内容不被固定底栏遮挡 */
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* ---------- hero 封面 ---------- */
.hero {
  height: 400rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  /* on-palette 渐变：原裸值 #3d6494/#5d7ba1/#8fa6c4 收编为令牌组合 */
  background: linear-gradient(135deg, var(--accent) 0%, var(--sky) 55%, var(--lavender) 100%);
}
.hero::before,
.hero::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: var(--surface);
}
.hero::before {
  top: -80rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  opacity: 0.08;
}
.hero::after {
  bottom: -40rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  opacity: 0.06;
}
.hero-cover {
  overflow: hidden;
}
.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
/* 深色遮罩保文字：原 rgba(0,0,0,渐变) 改 fg+透明度
   2026-09-15：封面换成浅色绘本插画后，均匀 0.45 深棕把整幅画压成灰绿（用户：像毛坯）。
   改纵向渐变——顶部留画、文字所在的中段压深、底部回浅，既保住白字对比度也不糊画面。 */
.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(var(--fg-rgb), 0.10) 0%,
    rgba(var(--fg-rgb), 0.44) 42%,
    rgba(var(--fg-rgb), 0.52) 68%,
    rgba(var(--fg-rgb), 0.26) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0 40rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--surface);
}
.hero-sub {
  color: var(--gold-light);
  margin-top: 12rpx;
  font-size: 26rpx;
}

/* ---------- 活动信息卡 ---------- */
.section {
  background: var(--surface);
  margin: 24rpx 32rpx 0;
  border: 3rpx solid var(--fg);
  border-radius: var(--radius);
  padding: 32rpx 40rpx;
  box-shadow: var(--shadow-hard-sm);
}
.sec-head {
  font-size: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-body {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--fg);
}
/* 信息卡：不再负 margin 上滑（原 -48rpx 盖住「活动信息」标题=遮挡缺陷）。
   2026-09-15：补内边距 —— 它靠 app.wxss 的卡片组拿到边框/底色，那条规则没有 padding，
   于是「费用/名额/介绍」全部左右贴着内框（用户截图）。 */
.info-card {
  position: relative;
  padding: 24rpx 28rpx;
}

.capacity-wrap {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--border);
}
.capacity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.capacity-bar {
  height: 16rpx;
  background: var(--border);
  border-radius: 16rpx;
  overflow: hidden;
}
.cap-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--sky));
  border-radius: 16rpx;
  transition: width 0.8s ease;
}
.capacity-hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}
.price-label {
  font-size: 24rpx;
  color: var(--muted);
}
.price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--success);
}

/* 键值行：布局走页内定义（.kv-row），卡片化外观走 app.wxss 公共类 .info-row（全站统一） */
.kv-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
}
.kv-label {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}
.kv-value {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
  flex: 1;
}

/* ---------- 报名状态条（2026-09-20：出码能力已迁往 pages/activity-pkg/ticket）---------- */
.enroll-strip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: var(--radius-sm);
}
.strip-text {
  flex: 1;
  min-width: 0;
}
.strip-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg);
}
.strip-icon {
  width: 32rpx;
  height: 32rpx;
}
.strip-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}
.strip-btn {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--surface);
  background: var(--accent);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
}
.strip-btn::after { border: none; }

/* ---------- 固定底栏（z ≤99 档；自带安全区） ---------- */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  background: var(--surface);
  border-top: 3rpx solid var(--fg);
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom, 16rpx) + 24rpx);
  z-index: 99;
}
.action-bar .btn-primary,
.action-bar .btn-outline {
  width: 100%;
}

