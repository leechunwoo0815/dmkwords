<view class="page-bg">
  <view class="tabs">
    <view class="tab {{tab === 'upcoming' ? 'active' : ''}}" data-tab="upcoming" bindtap="onTab">可报名</view>
    <view class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="onTab">我的报名</view>
    <view class="tab {{tab === 'past' ? 'active' : ''}}" data-tab="past" bindtap="onTab">往期回顾</view>
  </view>

  <loading-skeleton wx:if="{{loading && !loadError}}" type="rows" rows="{{3}}" />

  <error-view wx:if="{{loadError}}" type="network" title="加载失败"
    desc="活动列表加载失败，请重试" bind:onRetry="onRetryLoad" />

  <block wx:if="{{!loading && !loadError && tab === 'upcoming'}}">
    <empty-state wx:if="{{!activities.length}}" icon-name="calendar" title="近期没有活动"
      desc="有新活动会第一时间在这里发布" />
    <view class="activity-list">
      <view wx:for="{{activities}}" wx:key="id" class="activity-card" data-id="{{item.id}}" bindtap="goDetail">
        <view class="activity-banner banner-{{index % 3}}">
          <!-- T45：有封面显封面图，无封面保持渐变占位 -->
          <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" class="activity-banner-img" />
          <text class="activity-banner-text">{{item.fee_display}}</text>
        </view>
        <view class="activity-body">
          <view class="activity-title">{{item.title}}</view>
          <view class="activity-meta">
            <view class="meta-item"><image class="meta-icon" src="/icons/ui/clock.png" mode="aspectFit" />{{item.start_at}}</view>
            <view class="meta-item"><image class="meta-icon" src="/icons/ui/pin.png" mode="aspectFit" />{{item.location}}</view>
          </view>
          <view class="activity-footer">
            <text wx:if="{{item.full}}" class="activity-status status-full">已满</text>
            <text wx:else class="activity-status status-open">剩 {{item.quota_left}} 个名额</text>
            <text wx:if="{{item.member_only}}" class="activity-status">仅会员</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{!loading && !loadError && tab === 'mine'}}">
    <empty-state wx:if="{{!myEnrollments.length}}" icon-name="ticket" title="还没有报名"
      desc="去「可报名」看看有什么好玩的" />
    <view class="activity-list">
      <view wx:for="{{myEnrollments}}" wx:key="id" class="activity-card">
        <view class="activity-body">
          <view class="activity-title">{{item.activity_title}}</view>
          <view class="activity-meta">
            <view class="meta-item"><image class="meta-icon" src="/icons/ui/clock.png" mode="aspectFit" />{{item.activity_start_at}}</view>
          </view>
          <view class="activity-footer">
            <text class="activity-status">{{item.statusText}}</text>
            <!-- 2026-09-20 客户口径：列表不再默认露出券码（露出即等于"码就在眼前"），
                 要出示走「出示签到码」按钮 → 独立入场券页 -->
            <text class="meta-item" wx:if="{{item.checkedInAtText}}">{{item.checkedInAtText}}</text>
          </view>
          <view class="mine-actions">
            <button wx:if="{{item.canShowTicket}}" class="mine-btn mine-btn-primary"
              data-id="{{item.id}}" bindtap="goTicket">出示签到码</button>
            <button class="mine-btn" data-id="{{item.activity_id}}" bindtap="goMineDetail">查看活动</button>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 往期活动回顾（2026-09-20 C 批）：只读内容——用当时的照片与图文回顾，吸引新家长报名 -->
  <block wx:if="{{!loading && !loadError && tab === 'past'}}">
    <empty-state wx:if="{{!pastActivities.length}}" icon-name="calendar" title="还没有往期活动"
      desc="办过的活动会在这里留下照片和回顾" />
    <view class="activity-list">
      <view wx:for="{{pastActivities}}" wx:key="id" class="activity-card"
        data-id="{{item.id}}" bindtap="goDetail">
        <view class="activity-banner banner-{{index % 3}}">
          <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" class="activity-banner-img" />
          <text class="activity-banner-text past-badge">往期回顾</text>
        </view>
        <view class="activity-body">
          <view class="activity-title">{{item.title}}</view>
          <view class="activity-meta">
            <view class="meta-item"><image class="meta-icon" src="/icons/ui/clock.png" mode="aspectFit" />{{item.start_at}}</view>
            <view class="meta-item"><image class="meta-icon" src="/icons/ui/child.png" mode="aspectFit" />{{item.peopleText}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
