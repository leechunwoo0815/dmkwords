/* pages/activity-pkg/activity-list/activity-list.wxss — 活动列表（2026-09-13 按统一模板契约重做）
   本页特色：无（骨架/状态/控件全部走全局公共类与四件套组件） */
.page-bg {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  /* 底部留白 ≥ 安全区：内容不被系统.home indicator 顶住 */
  padding: 20rpx 0 calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- tab 胶囊（触控区 ≥88rpx，MP-018） ---------- */
.tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 24rpx 16rpx;
}
.tab {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: var(--shadow-hard-sm);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--muted);
}
.tab.active {
  background: var(--sun);
  color: var(--fg);
  box-shadow: 2rpx 2rpx 0 rgba(var(--fg-rgb), 0.85);
}

/* ---------- 活动卡 ---------- */
.activity-list {
  padding: 8rpx 32rpx 0;
}
.activity-card {
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-hard-sm);
}
/* 根修（2026-09-13）：banner 必须是定位锚——此前缺 position:relative，
   封面图 absolute 一路锚到页面根铺满全屏（用户投诉的"封面糊脸"） */
.activity-banner {
  position: relative;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner-0 {
  background: linear-gradient(135deg, var(--sky-soft), var(--secondary-soft));
}
.banner-1 {
  background: linear-gradient(135deg, var(--secondary-soft), var(--accent-soft));
}
.banner-2 {
  background: linear-gradient(135deg, var(--sun-soft), var(--sky-soft));
}
.activity-banner-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
/* 费用价签（2026-09-15）：原为居中、无底的 --accent 橙字，直接压在绘本封面上
   ——横条封面是绿色山丘 + 橙红热气球，橙字既看不清、又和气球撞在一起。
   改左下角实底价签：任何封面上都保证对比度，语义上也更像「价签」而不是标题。 */
.activity-banner-text {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-dark);
  text-align: center;
  padding: 8rpx 26rpx;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: 999rpx;
  box-shadow: var(--shadow-hard-sm);
}
.activity-body {
  padding: 28rpx 32rpx;
}
.activity-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
  line-height: 1.4;
  margin-bottom: 24rpx;
  display: block;
}
.activity-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-icon {
  font-size: 28rpx;
}
.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.activity-status {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.status-open {
  background: var(--success-soft);
  color: var(--success);
}
.status-full {
  background: var(--error-soft);
  color: var(--error);
}
.status-past {
  background: var(--bg);
  color: var(--muted);
}

/* 2026-09-15（用户两轮反馈"活动页还是遮挡，按钮往上挪不行吗"）：
   原 top:112rpx 是错的 —— 本页用**原生导航栏**且没有自绘导航，页面内容区
   本来就是从 y=0 起算；再让吸顶条「距顶 112rpx 才吸附」，它一滚动就**往下跳 112rpx**，
   正好压在第一个活动卡上把卡片上半部分盖住。改为贴内容区顶部吸附（用户说的"往上挪"）。
   对照：order-history 自绘了 sticky 导航栏，它的 top:96rpx 是对的口径，勿动。 */
.tabs { background: var(--surface); position: sticky; top: 0; z-index: 9; }

.meta-icon { width: 28rpx; height: 28rpx; margin-right: 6rpx; }

/* ---------- 「我的报名」项内动作（2026-09-20 客户口径：出示签到码 / 查看活动） ---------- */
.mine-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.mine-btn {
  flex: 1;
  margin: 0;
  padding: 0 20rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--fg);
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 999rpx;
}
.mine-btn::after { border: none; }
.mine-btn-primary {
  color: var(--surface);
  background: var(--accent);
  border-color: var(--fg);
  box-shadow: var(--shadow-hard-sm);
}

/* 往期回顾角标（2026-09-20 C 批）：压在封面右下，与"费用"角标同位不同色 */
.past-badge {
  background: var(--muted);
  color: var(--surface);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
}
