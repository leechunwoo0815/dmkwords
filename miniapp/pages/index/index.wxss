/* pages/index/index.wxss — 首页 v5：任务台布局 */
.page-root {
  height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
}

/* ---------- 问候卡 ---------- */
.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--accent) 0%, #ff8c53 100%);
  border: 4rpx solid var(--fg);
  border-radius: var(--radius);
  box-shadow: var(--shadow-hard);
  padding: 36rpx 32rpx;
  color: #fff;
}
.hero-greeting {
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 700;
}
.hero-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.18);
}
.badge-done { background: var(--secondary); border-color: var(--fg); color: #fff; }
.badge-todo { background: var(--sun); border-color: var(--fg); color: var(--fg); font-weight: 700; }
.streak-sticker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 4rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
  color: var(--fg);
}
.streak-num { font-family: var(--font-display); font-size: 44rpx; font-weight: 800; color: var(--accent); line-height: 1; }
.streak-label { font-size: 18rpx; margin-top: 4rpx; color: var(--muted); }

.empty-child {
  background: var(--surface);
  border: 4rpx dashed var(--border);
  border-radius: var(--radius);
  padding: 60rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
}

/* ---------- 多孩切换 ---------- */
.child-chips { display: flex; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }
.chip {
  padding: 10rpx 30rpx;
  background: var(--surface);
  border: 3rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.chip-on { background: var(--accent); border-color: var(--fg); color: #fff; font-weight: 700; }

/* ---------- 提醒条 ---------- */
.notice-row { display: flex; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }
.notice-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--accent-soft);
  border: 3rpx solid var(--accent);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--fg);
  font-weight: 600;
}
.notice-emoji { font-size: 26rpx; }

/* ---------- 区块通用 ---------- */
.section { margin-top: 36rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title {
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 800;
  color: var(--fg);
  margin-bottom: 20rpx;
}
.section-more { font-size: 26rpx; color: var(--accent); font-weight: 600; margin-bottom: 20rpx; }

/* ---------- 续听卡 ---------- */
.continue-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface);
  border: 4rpx solid var(--fg);
  border-radius: var(--radius);
  box-shadow: var(--shadow-hard);
  padding: 24rpx;
}
.continue-cover {
  width: 150rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  border: 3rpx solid var(--fg);
  flex-shrink: 0;
  background: var(--accent-soft);
}
.continue-info { flex: 1; min-width: 0; }
.continue-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.continue-meta { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.progress-track {
  height: 14rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
.progress-fill { height: 100%; background: var(--accent); border-radius: 999rpx; }
.continue-pct { font-size: 20rpx; color: var(--accent); font-weight: 700; margin-top: 8rpx; }
.continue-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--accent);
  border: 4rpx solid var(--fg);
  box-shadow: var(--shadow-hard-sm);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding-left: 8rpx;
}

/* ---------- 今日数据 ---------- */
.stat-row { display: flex; gap: 20rpx; margin-top: 28rpx; }
.stat-cell {
  flex: 1;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num { font-family: var(--font-display); font-size: 40rpx; font-weight: 800; color: var(--accent); line-height: 1.1; }
.stat-label { font-size: 20rpx; color: var(--muted); margin-top: 6rpx; }

/* ---------- 今日推荐横滑 ---------- */
.rec-scroll { width: 100%; }
.rec-row { display: flex; gap: 20rpx; padding: 4rpx 4rpx 12rpx; }
.rec-card {
  width: 200rpx;
  flex-shrink: 0;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 12rpx;
  box-sizing: border-box;
}
.rec-cover-wrap { position: relative; }
.rec-cover {
  width: 100%;
  height: 260rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  display: block;
  background: var(--accent-soft);
}
.rec-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.rec-audio {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  background: var(--surface);
  border: 2rpx solid var(--fg);
  border-radius: 50%;
  width: 44rpx;
  height: 44rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--fg);
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-tags { display: flex; gap: 8rpx; margin-top: 8rpx; }
.rec-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 700;
}
.rec-tag-words { background: rgba(74, 222, 128, 0.14); color: var(--success); }

/* ---------- 快捷入口 2x4 ---------- */
.entry-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.entry {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--surface);
  border: 3rpx solid var(--fg);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-hard-sm);
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid var(--fg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.e-orange { background: var(--accent-soft); }
.e-green { background: rgba(74, 222, 128, 0.18); }
.e-blue { background: rgba(96, 165, 250, 0.18); }
.e-gold { background: rgba(252, 211, 77, 0.28); }
.e-pink { background: rgba(244, 114, 182, 0.16); }
.e-purple { background: rgba(167, 139, 250, 0.18); }
.e-cyan { background: rgba(94, 234, 212, 0.2); }
.entry-name { font-size: 26rpx; font-weight: 700; color: var(--fg); }

.page-footer {
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
  padding: 48rpx 0 8rpx;
}
