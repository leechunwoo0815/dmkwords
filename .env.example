# =============================================================================
# DmkWords 环境配置模板（2026-10-08 对齐 backend/config.py 全量键）
# =============================================================================
# 用法：cp .env.example .env  然后填真实值（.env 已在 .gitignore，绝不入库）
# 配置说明与"该向甲方要什么"：见 docs/21-微信小程序与支付配置操作手册-20261008.md
# 校验：
#   python -m scripts.check_wechat_credentials            # 凭证/证书/回调 URL 自检
#   APP_ENV=production 时启动会跑 validate_production（缺件拒启）
# =============================================================================

# ─── 应用 ────────────────────────────────────────────────────────────────
APP_NAME=DmkWords API
APP_VERSION=1.0.0
# 生产判定开关（dev/production）：production 时即使 DEBUG=true 也全量硬校验
APP_ENV=dev
DEBUG=true
# 开发期固定验证码（本地 1234）；生产必须置空（validate_production 硬校验）
LOGIN_DEV_CODE=1234
ENABLE_TEST_TOKEN=false

# ─── 数据库（MySQL 8.0 only，单一数据库铁律）────────────────────────────
# 本地：OrbStack 容器 dmkwords-mysql:3306（orb start + docker start dmkwords-mysql）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dmkwords

# ─── JWT ─────────────────────────────────────────────────────────────────
# 生产必须强随机（禁默认值 change-in-production）
SECRET_KEY=change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_TOKEN_EXPIRE_HOURS=8

# ─── 微信小程序（登录主通道；资料见 docs/21 §一 ①②）────────────────────
# AppID 公开；AppSecret 保密（只写这里，别贴聊天）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 订阅消息通道开关（false=只落库不推送；模板 ID 在 backend/integrations/wechat/config.py）
WECHAT_SUBSCRIBE_ENABLED=false

# ─── 线上支付开关（WM12）────────────────────────────────────────────────
# PAYMENT_ENABLED=false → 小程序不出现支付入口（纯人工收款版本）
# PAYMENT_PROVIDER=mock（开发/演示，即时到账）/ wechat（生产真通道；mock 生产拒启）
PAYMENT_ENABLED=true
PAYMENT_PROVIDER=mock

# ─── 微信支付 V3 四件套（PAYMENT_PROVIDER=wechat 时缺一拒启）─────────────
# 商户号 / APIv3 密钥（32 字节，保密）/ 商户证书序列号（公开）
WECHAT_MCH_ID=
WECHAT_API_KEY_V3=
WECHAT_CERT_SERIAL_NO=
# 商户私钥 PEM + 微信平台证书 PEM 的绝对路径（放 certs/，该目录已 gitignore；私钥权限建议 0400）
# 平台证书无需手工获取：部署后跑一次任务 wechat_cert_refresh 自动首刷
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PLATFORM_CERT_PATH=
# 支付/退款回调（都指向同一个端点 /api/pay/wechat/notify；必须 https 正式域名）
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

# ─── 短信（登录兜底 + 换手机号）─────────────────────────────────────────
# 本地 SMS_PROVIDER=mock（验证码打日志）；生产 aliyun/tencent 且凭据齐全（mock 拒启）
SMS_ENABLED=true
SMS_PROVIDER=mock
SMS_APP_ID=
SMS_APP_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ─── 安全 / 部署 ─────────────────────────────────────────────────────────
# 管理端跨域白名单（逗号分隔；生产禁含 localhost，同域反代可留空）
CORS_ORIGINS=http://localhost:5173
# 反向代理层数：0=不读 X-Forwarded-For（默认，防伪造）；nginx 覆盖式 XFF 时设 1（成对）
TRUSTED_PROXY_COUNT=0
# 进程内调度器（单进程唯一调度器；多副本时仅首副本开）
SCHEDULER_ENABLED=true

# ─── 服务器 ──────────────────────────────────────────────────────────────
BACKEND_PORT=8002
UPLOADS_DIR=uploads
