# =============================================================================
# DmkWords 环境配置模板
# =============================================================================
# 复制为 .env 并填写真实值:
#   cp .env.example .env
# =============================================================================

# ─── 应用 ────────────────────────────────────────────────────────────────
APP_NAME=DmkWords API
APP_VERSION=1.0.0
DEBUG=false
ENABLE_TEST_TOKEN=false

# ─── Mock 网关开关（生产环境必须关闭） ──────────────────────────────────
MOCK_PAYMENT=false
MOCK_SMS=false

# ─── 数据库 ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dmkwords

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_TOKEN_EXPIRE_HOURS=8

# ─── 微信开放平台 ────────────────────────────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ─── 微信支付 V2 ─────────────────────────────────────────────────────────
WECHAT_MCH_ID=
WECHAT_API_KEY=

# ─── 微信支付 V3 ─────────────────────────────────────────────────────────
WECHAT_API_KEY_V3=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=

# ─── 短信服务（Tencent Cloud / Aliyun） ────────────────────────────────
SMS_PROVIDER=
SMS_APP_ID=
SMS_APP_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ─── 服务器 ──────────────────────────────────────────────────────────────
BACKEND_PORT=8002
